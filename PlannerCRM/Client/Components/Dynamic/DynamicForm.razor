@using System.Reflection
@using System.ComponentModel
@using System.Threading.Tasks
@typeparam TItem where TItem : class, new()

<EditForm EditContext="@editContext"
          OnSubmit="HandleSubmit">
    <ValidationSummary />
    <DataAnnotationsValidator />
    <RadzenCard>
        @foreach (var prop in properties.OrderByDescending(x => x.IsRequired))
        {
            @if (SupportedTypes.Contains(prop.PropertyType))
            {
                <RadzenRow class="mt-3">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenLabel>
                            @prop.Label
                            @if (prop.IsRequired)
                            {
                                <span class="text-danger">*</span>
                            }
                        </RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        @RenderField(prop)
                    </RadzenColumn>
                </RadzenRow>
            }
        }

        @if (AdvancedContent != null)
        {
            @AdvancedContent
        }
    </RadzenCard>
    <RadzenCard class="mt-3">
        <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Text="Cancel" Click="@(() => dialog.Close())"></RadzenButton>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Text="Save"></RadzenButton>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>
</EditForm>

@code {
    [Parameter] public TItem Model { get; set; } = default!;
    [Parameter] public List<RenderFragment> AdvancedContent { get; set; } = default!;
    [Parameter] public Expression<Func<object>> For { get; set; }

    [Parameter] public EventCallback<TItem> OnReloadList { get; set; }

    List<PropertyMeta> properties = new();

    private EditContext editContext = default!;
    static readonly NullabilityInfoContext nullabilityContext = new();
    static readonly List<Type> SupportedTypes = new()
    {
        typeof(string),
        typeof(int),
        typeof(int?),
        typeof(decimal),
        typeof(decimal?),
        typeof(double),
        typeof(double?),
        typeof(bool),
        typeof(bool?),
        typeof(DateTime),
        typeof(DateTime?),
    };

    record PropertyMeta(
        PropertyInfo Property,
        string Label,
        Type PropertyType,
        bool IsRequired,
        bool IsNullable
    );

    protected override void OnParametersSet()
    {
        editContext = new EditContext(Model);

        properties = Model.GetType()
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanWrite && p.GetCustomAttribute<RequiredAttribute>() != null)
            .Select(p =>
                {
                    var underlyingType = Nullable.GetUnderlyingType(p.PropertyType) ?? p.PropertyType;

                    var nullability = nullabilityContext.Create(p);

                    bool isNullable =
                        Nullable.GetUnderlyingType(p.PropertyType) != null ||
                        nullability.ReadState == NullabilityState.Nullable;

                    return new PropertyMeta(
                        p,
                        p.GetCustomAttribute<DescriptionAttribute>()?.Description ?? p.Name,
                        underlyingType,
                        p.GetCustomAttribute<RequiredAttribute>() != null,
                        isNullable
                    );
                })
            .ToList();
    }

    RenderFragment RenderField(PropertyMeta meta)
    {
        RenderFragment result;

        if (meta.PropertyType == typeof(string))
        {
            result = RenderString(meta);
        } else if (meta.PropertyType == typeof(int) || meta.PropertyType == typeof(decimal) || meta.PropertyType == typeof(double))
        {
            result = RenderNumber(meta);
        } else if (meta.PropertyType == typeof(bool))
        {
            result = RenderBool(meta);
        } else if (meta.PropertyType == typeof(DateTime))
        {
            result = RenderDateTime(meta);
        } else
        {
            result =@<></>;
        }

        return result;
    }

    RenderFragment RenderString(PropertyMeta meta)
    {
        var value = meta.Property.GetValue(Model)?.ToString();

        return @<RadzenTextBox class="form-control w-100" Value="@(value)" Change="@((value) => Handle_AssignValue(meta, value))" />;
    }

    RenderFragment RenderNumber(PropertyMeta meta)
    {
        RenderFragment result;

        var value = meta.Property.GetValue(Model)?.ToString();

        if (meta.IsNullable)
        {
            if (meta.PropertyType == typeof(int))
            {
                result =@<RadzenNumeric class="form-control w-25" 
                                        TValue="int?" 
                                        Value="@(Convert.ToInt32(value))"
                                        Change="@((value) => Handle_AssignValue(meta, value))" />;
            } else if (meta.PropertyType == typeof(decimal))
            {
                result =@<RadzenNumeric class="form-control w-25" 
                                        TValue="decimal?" 
                                        Format="c" 
                                        Value="@(Convert.ToDecimal(value))"
                                        Change="@((value) => Handle_AssignValue(meta, value))" />;
            } else if (meta.PropertyType == typeof(double))
            {
                result =@<RadzenNumeric class="form-control w-25" 
                                        TValue="double?" 
                                        Value="@(Convert.ToDouble(value))"
                                        Change="@((value) => Handle_AssignValue(meta, value))" />;
            } else
            {
                result =@<></>;
            }
        } else
        {
            if (meta.PropertyType == typeof(int))
            {
                result =@<RadzenNumeric class="form-control w-25"
                               TValue="int"
                               Value="@(Convert.ToInt32(value))"
                               Change="@((value) => Handle_AssignValue(meta, value))" />;
            } else if (meta.PropertyType == typeof(decimal))
            {
                result =@<RadzenNumeric class="form-control w-25"
                               TValue="decimal"
                               Format="c"
                               Value="@(Convert.ToDecimal(value))"
                               Change="@((value) => Handle_AssignValue(meta, value))" />;
            } else if (meta.PropertyType == typeof(double))
            {
                result =@<RadzenNumeric class="form-control w-25"
                               TValue="double"
                               Value="@(Convert.ToDouble(value))"
                               Change="@((value) => Handle_AssignValue(meta, value))" />;
            } else
            {
                result =@<></>;
            }
        }

        return result;
    }

    RenderFragment RenderBool(PropertyMeta meta)
    {
        RenderFragment result;
        var value = meta.Property.GetValue(Model)?.ToString();

        if (meta.IsNullable)
        {
            result =@<RadzenRadioButtonList TValue="bool?">
                        <Items>
                            <RadzenRadioButtonListItem TValue="bool?" Value="true" Text="Yes"  />
                            <RadzenRadioButtonListItem TValue="bool?" Value="false" Text="No" />
                        </Items>
                    </RadzenRadioButtonList>;
        } else
        {
            result =@<RadzenRadioButtonList TValue="bool">
                <Items>
                    <RadzenRadioButtonListItem TValue="bool" Value="true" Text="Yes" />
                    <RadzenRadioButtonListItem TValue="bool" Value="false" Text="No" />
                </Items>
            </RadzenRadioButtonList>;
        }

        return result;
    }

    RenderFragment RenderDateTime(PropertyMeta meta)
    {
        RenderFragment result;
        var value = meta.Property.GetValue(Model)?.ToString();

        if (meta.IsNullable)
        {
            result =@<RadzenDatePicker Style="width:100%" DateFormat="dd/MM/yyyy" Value="@(Convert.ToDateTime(value))" TValue="DateTime ?" Change="@((value) => Handle_AssignValue(meta, value))" />;
        } else
        {
            result =@<RadzenDatePicker Style="width:100%" DateFormat="dd/MM/yyyy" Value="@(Convert.ToDateTime(value))" TValue="DateTime" Change="@((value) => Handle_AssignValue(meta, value))" />;
        }

        return result;
    }


    void Handle_AssignValue(PropertyMeta meta, object value)
    {
        Model.GetType().GetProperty(meta.Property.Name).SetValue(Model, value);

        editContext.NotifyFieldChanged(new FieldIdentifier(Model, meta.Property.Name));
    }

    async Task HandleSubmit()
    {
        if (editContext.Validate())
        {
            await OnReloadList.InvokeAsync(Model);
        }
    }
}
