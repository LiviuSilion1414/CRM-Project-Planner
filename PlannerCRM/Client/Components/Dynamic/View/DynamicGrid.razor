@using System.Reflection
@using System.ComponentModel
@using static PlannerCRM.Shared.Dtos.DtoShared
@typeparam TItem where TItem : class, new()

@if (containsType == false)
{
    <b>Not supported</b>
} else
{


    @if (TopContent != null)
    {
        <RadzenCard class="mt-3">
            @TopContent
        </RadzenCard>
    }

    @if (AllowDelete || AllowInsert)
    {
        <RadzenCard class=@($"mt-3 {getRowClass()}")>
            <RadzenRow class="mb-3">
                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenText>
                        Results found: <b>@ItemsList.Count</b>
                    </RadzenText>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenStack AlignItems="AlignItems.Center" class="mt-3" Orientation="Orientation.Horizontal">
                        <RadzenButton Icon="search_off"
                                      ButtonStyle="ButtonStyle.Info"
                                      Variant="Variant.Filled"
                                      Text="Reset"
                                      Visible="@ShowClear"
                                      Click="@Reset" />
                        <RadzenButton Icon="search"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Variant="Variant.Filled"
                                      Text="Search"
                                      Visible="@ShowSearch"
                                      Click="@LoadData" />
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>
    }

    <RadzenCard class="mt-3">
        <RadzenDataGrid @ref="grid"
                        TItem="@TItem"
                        Data="@ItemsList"
                        AllowSorting="@AllowSorting"
                        AllowFiltering="@AllowFiltering"
                        AllowPaging="true"
                        PageSize="20"
                        AllowRowSelectOnRowClick="false"
                        SelectionMode="DataGridSelectionMode.Multiple"
                        @bind-Value="@selectedItems"
                        PageSizeOptions="@pageSizeOptions">
            <HeaderTemplate>
                <RadzenStack AlignItems="AlignItems.Center" Gap="50px" class="mt-3">
                    <RadzenRow>
                        <RadzenColumn Size="12" SizeMD="12">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         Gap="10px">

                                @if (AllowInsert)
                                {
                                    <RadzenButton Icon="add_circle_outline"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Variant="Variant.Filled"
                                                  Text="New"
                                                  Click="@InsertRecord" />
                                }

                                @if (selectedItems != null && selectedItems.Any())
                                {
                                    <RadzenButton Icon="delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Filled"
                                                  Text="Delete"
                                                  Click="@DeleteMultipleRecords">
                                    </RadzenButton>
                                        //Delete (@selectedItems.Count)

                                    <RadzenLabel>Records selected: <b>@selectedItems.Count</b></RadzenLabel>
                                }

                                @if (AllowWordWrapHandling)
                                {
                                    <RadzenFormField Text="Max word wrap"
                                                     AllowFloatingLabel="true"
                                                     Style="width:200px;">
                                        <RadzenNumeric Style="width: 100%;"
                                                       @bind-Value="@maxWordWrapLength" />
                                    </RadzenFormField>
                                }

                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </HeaderTemplate>
            <EmptyTemplate>
                <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
                    <RadzenText style="color: var(--rz-text-disabled-color)">
                        No records found.
                    </RadzenText>
                </RadzenStack>
            </EmptyTemplate>
            <Columns>
                <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false" Visible="@AllowSelection">
                    <HeaderTemplate>
                        <RadzenCheckBox TabIndex="-1" TriState="false" TValue="bool?" InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select all items" } })"
                                        Value="@(selectedItems == null || selectedItems?.Any() != true ? false : !ItemsList.All(i => selectedItems.Contains(i)) ? null : ItemsList.Any(i => selectedItems.Contains(i)))"
                                        Change="@(args => selectedItems = args == true ? ItemsList.ToList() : null)" />
                    </HeaderTemplate>
                    <Template Context="data">
                        <RadzenCheckBox TabIndex="-1" TriState="false" Value="@ContainsItem(data)" TValue="bool" Change=@(args => grid.SelectRow(data)) />
                    </Template>
                </RadzenDataGridColumn>
                @if (MainColumns != null)
                {
                    @MainColumns
                } else
                {

                    @foreach (var prop in properties)
                    {
                        @RenderDataGridColumn(prop)
                    }
                }

                @if (selectedItems == null || !selectedItems.Any())
                {
                    @if (ExtraColumns != null)
                    {
                        @ExtraColumns
                    } else
                    {
                        @if (OnAdvancedUpdate.HasDelegate)
                        {
                            @RenderDataGridActionColumn(ColumnActionType.ADVANCED_UPDATE_READONLY)
                        } else
                        {
                            @RenderDataGridActionColumn(ColumnActionType.VIEW)
                        }
                        @if (AllowUpdate)
                        {
                            @RenderDataGridActionColumn(ColumnActionType.UPDATE)
                            @if (OnAdvancedUpdate.HasDelegate)
                            {
                                @RenderDataGridActionColumn(ColumnActionType.ADVANCED_UPDATE)
                            }
                        }
                        @if (AllowDelete)
                        {
                            @RenderDataGridActionColumn(ColumnActionType.DELETE)
                        }
                    }
                }
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    [Parameter] public string ApiController { get; set; }
    [Parameter] public string ModelTitle { get; set; }
    [Parameter] public bool AllowUpdate { get; set; } = true;
    [Parameter] public bool AllowDelete { get; set; } = true;
    [Parameter] public bool AllowInsert { get; set; } = true;
    [Parameter] public bool AllowSelection { get; set; } = true;
    [Parameter] public bool AllowFiltering { get; set; } = true;
    [Parameter] public bool AllowSorting { get; set; } = true;
    [Parameter] public bool AllowWordWrapHandling { get; set; } = false;
    [Parameter] public bool ShowClear { get; set; } = true;
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public List<TItem> ItemsList { get; set; } = new();
    [Parameter] public RenderFragment? TopContent { get; set; }
    [Parameter] public RenderFragment? MainColumns { get; set; }
    [Parameter] public RenderFragment? ExtraColumns { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback<TItem> OnInsert { get; set; }
    [Parameter] public EventCallback<TItem> OnAdvancedUpdate { get; set; }
    [Parameter] public EventCallback<TItem> OnAdvancedUpdateReadonly { get; set; }
    [Parameter] public EventCallback<TItem> OnUpdate { get; set; }
    [Parameter] public EventCallback<TItem> OnView { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public bool isReadonly { get; set; } = false;

    private string getRowClass() => isReadonly ? "form-disabled" : "";

    private List<PropertyMeta> properties = new();
    private IList<TItem>? selectedItems;
    private int maxWordWrapLength = 500;

    private bool containsType = false;

    IEnumerable<int> pageSizeOptions = new int[] { 20, 50, 100, 200 };

    RadzenDataGrid<TItem> grid;

    protected override async Task OnParametersSetAsync()
    {
        if (AllowUpdate || AllowDelete || AllowInsert)
        {
            if (string.IsNullOrEmpty(ApiController))
            {
                throw new ArgumentNullException("ApiController cannot be null");
            }
        }

        await ReloadModelProperties();
    }

    async Task ReloadModelProperties()
    {
        if (fetch.lookupMetaProperties.Any())
        {
            if (fetch.lookupMetaProperties.ContainsKey(typeof(TItem)))
            {
                properties = fetch.lookupMetaProperties[typeof(TItem)];
                containsType = true;
            } else
            {
                containsType = false;
                await ShowSendFeedbackDialog(new Exception($"The type {typeof(TItem).Name} is not supported.Please make sure the assembly containing the type is referenced and properly loaded"));
            }
        }
    }

    RenderFragment? RenderDataGridColumn(PropertyMeta meta)
    {
        if (DynamicPropertyMetaLoader.IsSupported(meta.underlyingType))
        {

            if (meta.underlyingType == typeof(string) ||
                meta.underlyingType == typeof(int) ||
                meta.underlyingType == typeof(double))
            {
                return@<RadzenDataGridColumn TItem="@TItem" Title="@meta.label" Property="@meta.property.Name" Sortable="true" Filterable="false">
                    <Template Context="data">
                        @{
                            var value = meta.property.GetValue(data)?.ToString();
                            var style = meta.isTextArea && meta.textAreaLength <= maxWordWrapLength ? "white-space:pre-wrap;" : "";
                        }
                        <RadzenLabel Text="@value" Style="@style" MouseEnter="@((e) => ShowTooltip(e, value))" />
                    </Template>
                </RadzenDataGridColumn>;
            } else if (meta.underlyingType == typeof(decimal))
            {
                return@<RadzenDataGridColumn TItem="@TItem" Title="@meta.label" Property="@meta.property.Name" Sortable="true" Filterable="false">
                    <Template Context="data">
                        @{
                            var value = string.Format("{0:#.00}", Convert.ToDecimal(meta.property.GetValue(data)) / 100);
                        }
                        <RadzenLabel Text="@value" MouseEnter="@((e) => ShowTooltip(e, value))" />
                    </Template>
                </RadzenDataGridColumn>;
            } else if (meta.underlyingType == typeof(bool))
            {
                return@<RadzenDataGridColumn TItem="@TItem" Title="@meta.label" Property="@meta.property.Name" Sortable="true" Filterable="false" TextAlign="TextAlign.Center">
                    <Template Context="data">
                        @if (Convert.ToBoolean(meta.property.GetValue(data)) == true)
                        {
                            <RadzenLabel MouseEnter="@((e) => ShowTooltip(e, "True"))" Style="font-weight:bold;">
                                <RadzenIcon Icon="check_circle" IconStyle="IconStyle.Success" />
                            </RadzenLabel>
                        } else
                        {
                            <RadzenLabel MouseEnter="@((e) => ShowTooltip(e, "False"))" Style="font-weight:bold;">
                                <RadzenIcon Icon="cancel" IconStyle="IconStyle.Danger" />
                            </RadzenLabel>
                        }
                    </Template>
                </RadzenDataGridColumn>;
            } else if (meta.underlyingType == typeof(DateTime))
            {
                return@<RadzenDataGridColumn TItem="@TItem" Title="@meta.label" Property="@meta.property.Name" Sortable="true" Filterable="false">
                    <Template Context="data">
                        @{
                            var value = string.Format("{0:dd/MM/yyyy}", meta.property.GetValue(data));
                        }
                        <RadzenLabel Text="@value" MouseEnter="@((e) => ShowTooltip(e, value))" />
                    </Template>
                </RadzenDataGridColumn>;
            } else
            {
                return@<span></span>;
            }
        } else
        {
            return@<span></span>;
        }
    }

    RenderFragment RenderDataGridActionColumn(ColumnActionType columnActionType)
    {
        return @<RadzenDataGridColumn TItem="@TItem" Width="64px" Sortable="false" Filterable="false">
            <Template Context="data">
                @if (ContainsItem(data) == false)
                {
                    @if (columnActionType == ColumnActionType.VIEW)
                    {
                        <RadzenButton Variant="Variant.Text" IconColor="@Colors.Primary" Icon="open_in_new" Click="@(() => ViewRecord(data))" MouseEnter="@((e) => ShowTooltip(e, "View Record"))"></RadzenButton>
                    } else if (columnActionType == ColumnActionType.UPDATE)
                    {
                        <RadzenButton Variant="Variant.Text" IconColor="@Colors.Secondary" Icon="bolt" Click="@(() => UpdateRecord(data))" MouseEnter="@((e) => ShowTooltip(e, "Fast Update"))"></RadzenButton>
                    } else if (columnActionType == ColumnActionType.ADVANCED_UPDATE)
                    {
                        <RadzenButton Variant="Variant.Text" IconColor="@Colors.PrimaryLight" Icon="edit" Click="@(() => AdvancedUpdateRecord(data))" MouseEnter="@((e) => ShowTooltip(e, "Advanced Update"))"></RadzenButton>
                    } else if (columnActionType == ColumnActionType.ADVANCED_UPDATE_READONLY)
                    {
                        <RadzenButton Variant="Variant.Text" IconColor="@Colors.PrimaryLight" Icon="open_in_new" Click="@(() => AdvancedUpdateReadonlyRecord(data))" MouseEnter="@((e) => ShowTooltip(e, "Advanced Update"))"></RadzenButton>
                    } else if (columnActionType == ColumnActionType.DELETE)
                    {
                        <RadzenButton Variant="Variant.Text" IconColor="@Colors.Danger" Icon="delete" Click="@(() => DeleteRecord(data))" MouseEnter="@((e) => ShowTooltip(e, "Delete Record"))"></RadzenButton>
                    }
                }
            </Template>
        </RadzenDataGridColumn>;
    }

    async Task Reset()
    {
        await OnReset.InvokeAsync();
    }

    async Task LoadData()
    {
        await OnReloadList.InvokeAsync();
    }


    async Task Submit_Add(TItem item)
    {
        var result = new ResultDto();

        try
        {
            result = await fetch.Dynamic_ExecuteAsync<TItem>(ApiController, ActionType.INSERT, item);

            if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadData();
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }

    async Task Submit_Edit(TItem item)
    {
        var result = new ResultDto();
        try
        {
            result = await fetch.Dynamic_ExecuteAsync<TItem>(ApiController, ActionType.UPDATE, item);

            if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadData();
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }

    private async Task DeleteRecord(TItem item)
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(item);
        } else
        {
            bool? confirm = await dialog.Confirm("Are you really sure you want to permanently delete this record? The operation is irreversible", "DELETE record");
            var result = new ResultDto();

            if (confirm != null && confirm == true)
            {
                try
                {
                    result = await fetch.Dynamic_ExecuteAsync<TItem>(ApiController, ActionType.DELETE, item);

                    if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
                    {
                        notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                        await LoadData();
                    } else
                    {
                        notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                    }
                } catch
                {
                    notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
                }
            }
        }
    }

    private async Task DeleteMultipleRecords()
    {

        bool? confirm = await dialog.Confirm("Are you really sure you want to permanently delete THE SELECTED records? The operation is irreversible!!!", "DELETE selected records");
        var result = new ResultDto();

        if (confirm != null && confirm == true)
        {
            try
            {
                List<Guid?> idList = selectedItems
                .Select(x =>
                {
                    var idProperty = x.GetType().GetProperty("id");
                    var value = idProperty.GetValue(x) != null ? Guid.Parse(idProperty.GetValue(x).ToString()) : new Guid?();

                    return value;
                })
                .ToList();

                result = await fetch.Dynamic_ExecuteAsync<Guid?>(ApiController, ActionType.DELETE_MULTIPLE, idList);

                if (!result.hasCompleted && result.statusCode != HttpStatusCode.OK)
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
                notification.Notify(NotificationSeverity.Success, $"{selectedItems.Count} record(s) had been deleted", null, 4000);
                await LoadData();
            } catch
            {
                notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
            }
        }
    }

    async Task ViewRecord(TItem item)
    {
        if (OnView.HasDelegate)
        {
            await OnView.InvokeAsync(item);
        } else
        {
            await dialog.OpenAsync($"{ModelTitle} Details", ds =>
            @<DynamicView TItem="@TItem" Model="@item" MetaProperties="@properties" />,
            new DialogOptions
            {
                Width = "80%",
                Height = "90%",
                CloseDialogOnEsc = true,
                ShowClose = true
            });
        }
    }

    async Task ShowSendFeedbackDialog(Exception exception)
    {
        await dialog.OpenAsync("Send feedback", ds => @<SendFeedback exception="exception" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }

    async Task AdvancedUpdateRecord(TItem item)
    {
        await OnAdvancedUpdate.InvokeAsync(item);
    }

    async Task AdvancedUpdateReadonlyRecord(TItem item)
    {
        await OnAdvancedUpdateReadonly.InvokeAsync(item);
    }

    async Task UpdateRecord(TItem item)
    {
        if (OnUpdate.HasDelegate)
        {
            await OnUpdate.InvokeAsync(item);
        } else
        {
            await dialog.OpenAsync($"Update {ModelTitle}", ds =>
            @<DynamicForm TItem="@TItem"
                          MetaProperties="@properties"
                          Model="@item"
                          OnSubmit="@Submit_Edit">
    <TopContent>
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenText TextStyle="TextStyle.H5"><RadzenLabel Style="font-weight:bold;">@(ModelTitle) Form</RadzenLabel></RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">This form allows you to insert new and update existing data.</RadzenText>
            </RadzenColumn>
        </RadzenRow>
    </TopContent>
</DynamicForm>
    ,
            new DialogOptions
            {
                Width = "80%",
                Height = "90%",
                CloseDialogOnEsc = true,
                ShowClose = true
            });
        }
    }

    async Task InsertRecord()
    {
        var newItem = new TItem();
        if (OnInsert.HasDelegate)
        {
            await OnInsert.InvokeAsync(newItem);
        } else
        {

            await dialog.OpenAsync($"New {ModelTitle}",
            ds =>@<DynamicForm TItem="@TItem"
                               MetaProperties="@properties"
                               Model="@newItem"
                               OnSubmit="@Submit_Add">
    <TopContent>
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenText TextStyle="TextStyle.H5"><RadzenLabel Style="font-weight:bold;">@(ModelTitle) Form</RadzenLabel></RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">This form allows you to insert new and update existing data.</RadzenText>
            </RadzenColumn>
        </RadzenRow>
    </TopContent>
</DynamicForm>
    ,
            new DialogOptions
            {
                Width = "80%",
                Height = "90%",
                CloseDialogOnEsc = true,
                ShowClose = true
            });
        }
    }

    bool ContainsItem(TItem item)
    {
        return selectedItems != null && selectedItems.Contains(item);
    }

    void ShowTooltip(ElementReference elementReference, string text, TooltipOptions? options = null)
    {
        var tooltipOptions = options ?? new TooltipOptions();

        tooltipOptions.Position = TooltipPosition.Bottom;
        tooltipOptions.Style ??= "white-space:pre-wrap";

        tooltip.Open(elementReference, text, tooltipOptions);
    }
}
