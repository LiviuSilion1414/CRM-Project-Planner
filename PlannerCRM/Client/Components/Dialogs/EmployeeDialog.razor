<RadzenRow class="row mt-3">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenText Text="Full name" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="9">
        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@SelectedEmployee.fullname</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenRow class="row mt-3">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenText Text="Username/Email" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="9">
        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@SelectedEmployee.username</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenRow class="row mt-3">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenText Text="Roles" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="9">
        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@SelectedEmployee.employeesRolesCommaSeparatedString</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenRow class="row mt-3">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenText Text="Created at" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="9">
        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@SelectedEmployee.creationDateString</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenRow class="row mt-3">
    <RadzenColumn Size="12" SizeMD="3">
        <RadzenText Text="Last seen at" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="9">
        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@SelectedEmployee.lastSeenString</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenRow AlignItems="AlignItems.Center" class="row mt-3">
    <RadzenColumn>
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Text="Delete" Click="OnDelete"></RadzenButton>
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Edit" Click="OnEdit"></RadzenButton>
    </RadzenColumn>
</RadzenRow>

@code
{
    [Parameter] public EmployeeDto SelectedEmployee { get; set; }
    [Parameter] public EventCallback<EmployeeDto> OnEditCallback { get; set; }
    [Parameter] public EventCallback<EmployeeDto> OnDeleteCallback { get; set; }
    [Parameter] public EventCallback OnReloadList { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task OnEdit()
    {
        await OnEditCallback.InvokeAsync(SelectedEmployee);
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new EmployeeFilterDto() { employeeId = SelectedEmployee.id };

            var result = await fetch.Employee_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                SelectedEmployee = JsonSerializer.Deserialize<EmployeeDto>(result.data.ToString());
            }
            fetch.isBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task OnDelete()
    {
        await OnDeleteCallback.InvokeAsync(SelectedEmployee);
    }

    async Task InvokeReloadList()
    {
        await OnReloadList.InvokeAsync();
        await LoadData();
    }
}
