<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Details">
            <RadzenRow class="row mt-3">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Full name" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@employeeDto.fullname</RadzenText>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow class="row mt-3">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Username/Email" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@employeeDto.username</RadzenText>
                </RadzenColumn>
            </RadzenRow>\

            <RadzenRow class="row mt-3">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Created at" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@employeeDto.creationDateString</RadzenText>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow class="row mt-3">
                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenText Text="Last seen at" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold">@employeeDto.lastSeenString</RadzenText>
                </RadzenColumn>
            </RadzenRow>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Roles">
            <RadzenRow class="mt-3">
                <RadzenColumn>
                    <RadzenDataGrid TItem="EmployeesRolesDto"
                                    Data="@employeeDto.employeesRoles"
                                    PageSize="20"
                                    AllowFiltering="false"
                                    AllowPaging="false"
                                    AllowSorting="true">
                        <Columns>
                            <RadzenDataGridColumn TItem="EmployeesRolesDto" Property="@nameof(EmployeesRolesDto.fkIdRoleNavigation.name)" Title="Role Name">
                                <Template Context="data">
                                    @data.fkIdRoleNavigation.name
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenColumn>
            </RadzenRow>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>


<RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
    <RadzenRow AlignItems="AlignItems.Center" class="row mt-3">

        <RadzenColumn>
            <RadzenButton ButtonType="ButtonType.Button" Text="Close" Click="@(() => dialog.Close())"></RadzenButton>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

@code
{
    [Parameter] public EmployeeDto employeeDto { get; set; }
    [Parameter] public EventCallback<EmployeeDto> OnEditCallback { get; set; }
    [Parameter] public EventCallback<EmployeeDto> OnDeleteCallback { get; set; }
    [Parameter] public EventCallback OnReloadList { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task OnEdit()
    {
        await OnEditCallback.InvokeAsync(employeeDto);
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new EmployeeFilterDto() { employeeId = employeeDto.id };

            var result = await fetch.Employee_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                employeeDto = JsonSerializer.Deserialize<EmployeeDto>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task OnDelete()
    {
        await OnDeleteCallback.InvokeAsync(employeeDto);
    }

    async Task InvokeReloadList()
    {
        await OnReloadList.InvokeAsync();
        await LoadData();
    }
}
