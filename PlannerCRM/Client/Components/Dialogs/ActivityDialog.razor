    RenderFragment ShowRoles(EmployeeDto employee)
    {
        return
    @<div>
        @if (employee.employeesRoles.OrderBy(x => x.id).FirstOrDefault() != null)
    {
    if (employee.employeesRoles.OrderBy(x => x.id).ToList().Count == 1)
    {
        @($"{employee.employeesRoles.OrderBy(x => x.id).FirstOrDefault().roleName}")
    }
    else
    {
        @($"{employee.employeesRoles.OrderBy(x => x.id).FirstOrDefault().roleName} + {employee.employeesRoles.Count - 1}")
    }
    }
    else
    {
        <b>no employeesRoles assigned</b>
    }
    </div>;
    }

