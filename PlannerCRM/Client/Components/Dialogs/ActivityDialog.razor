<RadzenCard>
    <RadzenTabs SelectedIndex="0" TabPosition="TabPosition.Top">
        <Tabs>
            <RadzenTabsItem Text="General info">
                <RadzenRow class="row mt-3">
                    <RadzenColumn class="col-lg-3 col-md-5">
                        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold" Text="Client" />
                    </RadzenColumn>
                    <RadzenColumn class="col-lg-9 col-md-7 w-100">
                        <RadzenText>@SelectedActivity.fkIdFirmClientNavigation.name</RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow class="row mt-3">
                    <RadzenColumn class="col-lg-3 col-md-5">
                        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold" Text="Workorder" />
                    </RadzenColumn>
                    <RadzenColumn class="col-lg-9 col-md-7 w-100">
                        <RadzenText>@SelectedActivity.fkIdWorkOrderNavigation.name</RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow class="row mt-3">
                    <RadzenColumn class="col-lg-3 col-md-5">
                        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold" Text="name" />
                    </RadzenColumn>
                    <RadzenColumn class="col-lg-9 col-md-7 w-100">
                        <RadzenText>@SelectedActivity.name</RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow class="row mt-3">
                    <RadzenColumn class="col-lg-3 col-md-5">
                        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold" Text="Starts" />
                    </RadzenColumn>
                    <RadzenColumn class="col-lg-9 col-md-7 w-100">
                        <RadzenText>@SelectedActivity.startDateString</RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow class="row mt-3">
                    <RadzenColumn class="col-lg-3 col-md-5">
                        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold" Text="Ends" />
                    </RadzenColumn>
                    <RadzenColumn class="col-lg-9 col-md-7 w-100">
                        <RadzenText>@SelectedActivity.endDateString</RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow class="row mt-3">
                    <RadzenColumn class="col-lg-3 col-md-5">
                        <RadzenText TextStyle="TextStyle.Body1" class="fw-semibold" Text="Created at" />
                    </RadzenColumn>
                    <RadzenColumn class="col-lg-9 col-md-7 w-100">
                        <RadzenText>@SelectedActivity.creationDateString</RadzenText>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenStack AlignItems="AlignItems.Center">
                    <RadzenRow>
                        <RadzenColumn>
                            <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Text="Delete" Click="OnDelete"></RadzenButton>
                            <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Edit" Click="OnEdit"></RadzenButton>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Employees">
                <RadzenDataGrid Data="@SelectedActivity.employeeActivities"
                TItem="@EmployeeActivityDto"
                AllowSorting="true"
                AllowPaging="true"
                AllowFiltering="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="@EmployeeActivityDto" Title="Name">
                            <Template Context="data">
                                @data.fkIdEmployeeNavigation.name
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="@EmployeeActivityDto" Title="Email">
                            <Template Context="data">
                                @data.fkIdEmployeeNavigation.username
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="@EmployeeActivityDto" Title="Created at">
                            <Template Context="data">
                                @data.fkIdEmployeeNavigation.creationDateString
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>

@code
{
    [Parameter] public ActivityDto SelectedActivity { get; set; }
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public EventCallback OnCloseSide { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new ActivityFilterDto() { employeeId = SelectedActivity.id };

            var result = await fetch.Activity_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                SelectedActivity = JsonSerializer.Deserialize<ActivityDto>(result.data.ToString());
            }
            fetch.isBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task OnEdit()
    {
        await dialog.OpenAsync("Update activity", ds =>
            @<ActivityForm 
                    Model=@SelectedActivity
                    IsInsert=@false
                    OnReloadList =@EventCallback.Factory.Create(this, InvokeReloadList)
            />,
            new DialogOptions
            {
                Width="80vw;"
            }
        );
    }

    private async Task OnDelete()
    {
        try
        {
            if ((await dialog.Confirm("Confirm this item removal", "Delete activity", null)).Value)
            {
                var filter = new ActivityFilterDto() { activityId = SelectedActivity.id };

                var result = await fetch.Activity_Delete(filter);

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await InvokeReloadList();
                }
                else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        }
        catch (Exception exception)
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task InvokeReloadList()
    {
        await OnReloadList.InvokeAsync();
    }

