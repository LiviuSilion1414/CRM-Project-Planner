<RadzenCard>
    <RadzenTabs SelectedIndex="0" TabPosition="TabPosition.Left">
        <Tabs>
            <RadzenTabsItem Text="General info">
                <RadzenRow class="mt-3">
                    <RadzenColumn>
                        <RadzenFieldset Text="Activity Information">
                            <RadzenColumn>
                                <RadzenText>Name: @SelectedActivity.name</RadzenText>
                                <RadzenText>Start Date: @SelectedActivity.startDateString</RadzenText>
                                <RadzenText>End Date: @SelectedActivity.endDateString</RadzenText>
                                <RadzenButton Variant="Variant.Text" IconColor="@Colors.Info" Icon="open_in_new" Click="@OnEdit"></RadzenButton>
                            </RadzenColumn>
                        </RadzenFieldset>
                    </RadzenColumn>
                    <RadzenColumn>
                        <RadzenFieldset Text="Client Information">
                            <RadzenColumn>
                                <RadzenText>Name: @SelectedActivity.fkIdWorkOrderNavigation.fkIdFirmClientNavigation.name</RadzenText>
                                <RadzenText>Vat Number: @SelectedActivity.fkIdWorkOrderNavigation.fkIdFirmClientNavigation.vatNumber</RadzenText>
                                <RadzenButton Variant="Variant.Text" IconColor="@Colors.Info" Icon="open_in_new" Click="@(() => OpenClientDetails(SelectedActivity.fkIdWorkOrderNavigation.fkIdFirmClientNavigation))"></RadzenButton>
                            </RadzenColumn>
                        </RadzenFieldset>
                    </RadzenColumn>
                    <RadzenColumn>
                        <RadzenFieldset Text="Work Order Information">
                            <RadzenColumn>
                                <RadzenText>Name: @SelectedActivity.fkIdWorkOrderNavigation.name</RadzenText>
                                <RadzenText>Start Date: @SelectedActivity.fkIdWorkOrderNavigation.startDateString</RadzenText>
                                <RadzenText>End Date: @SelectedActivity.fkIdWorkOrderNavigation.endDateString</RadzenText>
                                <RadzenButton Variant="Variant.Text" IconColor="@Colors.Info" Icon="open_in_new" Click="@(() => OpenWorkOrderDetails(SelectedActivity.fkIdWorkOrderNavigation))"></RadzenButton>
                            </RadzenColumn>
                        </RadzenFieldset>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack AlignItems="AlignItems.Center">
                    <RadzenRow>
                        <RadzenColumn>
                            <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Text="Delete" Click="OnDelete"></RadzenButton>
                            <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Edit" Click="OnEdit"></RadzenButton>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Employees">
                <RadzenDataGrid Data="@SelectedActivity.employeeActivities"
                TItem="@EmployeeActivityDto"
                AllowSorting="true"
                AllowPaging="true"
                AllowFiltering="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="@EmployeeActivityDto" Title="Name">
                            <Template Context="data">
                                @data.fkIdEmployeeNavigation.name
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="@EmployeeActivityDto" Title="Role(s)">
                            <Template Context="data">
                                @ShowRoles(data.fkIdEmployeeNavigation)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="@EmployeeActivityDto" Title="Email">
                            <Template Context="data">
                                @data.fkIdEmployeeNavigation.username
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="@EmployeeActivityDto" Title="Created at">
                            <Template Context="data">
                                @data.fkIdEmployeeNavigation.creationDateString
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>

@code
{
    [Parameter] public ActivityDto SelectedActivity { get; set; }
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public EventCallback OnCloseSide { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private async Task OnEdit()
    {
