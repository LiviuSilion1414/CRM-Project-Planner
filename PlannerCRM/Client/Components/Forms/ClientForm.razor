@using System.Text
@using static PlannerCRM.Shared.Dtos.DtoShared
@layout MainLayout

@attribute [Authorize]

@if (fetch.isBusy)
{
    <Loader />
} else
{
    <RadzenCard class="mt-3 mb-3">
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenText TextStyle="TextStyle.H5"><RadzenLabel Style="font-weight:bold;">Client Form</RadzenLabel></RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">This form allows you to insert new and update existing data.</RadzenText>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenStack JustifyContent="JustifyContent.Center">
        <RadzenCard>
            <RadzenTabs TabPosition="TabPosition.Left" SelectedIndex="@index">
                <Tabs>
                    <RadzenTabsItem Text="General Details">
                        <DynamicForm TItem="@FirmClientDto"
                                     MetaProperties="@fetch.lookupMetaProperties[typeof(FirmClientDto)]"
                                     Model="@firmClientDto"
                                     OnSubmit="@Update">
                        </DynamicForm>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Assigned Work Orders">
                        <RadzenRow class="mt-3">
                            <RadzenColumn>
                                <DynamicGrid ApiController="@ApiUrl.WORKORDER_CONTROLLER"
                                             TItem="@WorkOrderDto"
                                             AllowInsert="true"
                                             OnInsert="@NewWorkOrder"
                                             ItemsList="@firmClientDto.workOrders.ToList()"
                                             ModelTitle="Client's Work Orders"
                                             OnReloadList="LoadFirmClientData"
                                             ShowClear="false"
                                             ShowSearch="false">
                                    <MainColumns>
                                        <RadzenDataGridColumn TItem="@WorkOrderDto" Title="Title" Sortable="true" Filterable="false">
                                            <Template Context="data">
                                                @data.name
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="@WorkOrderDto" Title="Created on" Sortable="true" Filterable="false">
                                            <Template Context="data">
                                                @data.creationDateString
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="@WorkOrderDto" Title="Start on" Sortable="true" Filterable="false">
                                            <Template Context="data">
                                                @data.startDateString
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="@WorkOrderDto" Title="Start on" Sortable="true" Filterable="false">
                                            <Template Context="data">
                                                @data.endDateString
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </MainColumns>
                                    <ExtraColumns>
                                        <RadzenDataGridColumn TItem="@WorkOrderDto" Width="64px" Sortable="false" Filterable="false">
                                            <Template Context="data">
                                                <RadzenButton Icon="delete" Variant="Variant.Text" IconColor="@Colors.Danger" Click="@(() => RemoveWorkOrder(data))"></RadzenButton>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </ExtraColumns>
                                </DynamicGrid>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    </RadzenStack>
}

@code
{
    [Parameter] public FirmClientDto firmClientDto { get; set; } = new();
    [Parameter] public EventCallback OnReloadList { get; set; }

    List<WorkOrderDto> workOrdersList = new List<WorkOrderDto>();
    int index;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkOrders();
    }

    void Close()
    {
        dialog.Close();
    }

    void GetEmployee(FirmClientDto firmClientDtoUpd)
    {
        firmClientDto = firmClientDtoUpd;
    }

    async Task NewWorkOrder()
    {
        await dialog.OpenAsync("Assign WorkOrders", ds =>
        @<Client_AddWorkOrders firmClientDto="@firmClientDto" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }

    private async Task LoadWorkOrders()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            result = await fetch.WorkOrder_List(new WorkOrderFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                workOrdersList = JsonSerializer.Deserialize<List<WorkOrderDto>>(result.data.ToString());
                await InvokeAsync(StateHasChanged);
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }

    private async Task LoadFirmClientData()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            var filter = new FirmClientFilterDto() { firmClientId = firmClientDto.id };

            result = await fetch.FirmClient_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                firmClientDto = JsonSerializer.Deserialize<FirmClientDto>(result.data.ToString());
                await InvokeAsync(StateHasChanged);
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }


    async Task RemoveWorkOrder(WorkOrderDto workOrderDtoUpd)
    {
        try
        {
            bool? confirm = await dialog.Confirm("Are you really sure you want to permanently delete this work order from the client? The operation is irreversible", "Delete record");

            if (confirm != null && confirm == true)
            {
                workOrderDtoUpd.fkIdFirmClient = null;
                var result = await fetch.WorkOrder_Update(workOrderDtoUpd);

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadFirmClientData();
                    await OnReloadList.InvokeAsync();
                    await InvokeAsync(StateHasChanged);
                } else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Error, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task Update(FirmClientDto firmClientDtoUpd)
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.FirmClient_Update(firmClientDtoUpd);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {

            }
            fetch.isBusy = false;
            await OnReloadList.InvokeAsync();
            await InvokeAsync(StateHasChanged);
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

}
