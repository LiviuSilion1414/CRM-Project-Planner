
<RadzenCard>
    <RadzenDataGrid TItem="@RoleDto"
                    Data="@rolesDtoList.OrderBy(x => x.fkIdGroupRoleNavigation.title)"
                    AllowSorting="false"
                    AllowFiltering="false">
        <Columns>
            <RadzenDataGridColumn Property="@(nameof(RoleDto.name))" Title="Name" />
            <RadzenDataGridColumn Title="Group">
                <Template Context="data">
                    @data.fkIdGroupRoleNavigation.title
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="55px">
                <Template Context="data">
                    <RadzenButton Icon="add"
                                  Click="@(() => SelectRole(data))"
                                  Style="@(getCssClass(isDisabled(data)))"
                                  Disabled="@isDisabled(data)" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
        <RadzenRow>
            <RadzenColumn Size="6">
                <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Text="Cancel" Click="dialog.Close"></RadzenButton>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
</RadzenCard>

@code
{
    [Parameter] public MenuDto menuDto { get; set; }
    [Parameter] public EventCallback<MenuDto> OnReloadList { get; set; }

    List<RoleDto> rolesDtoList = new List<RoleDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadEmployeeData()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            var filter = new MenuFilterDto() { id = menuDto.id };

            result = await fetch.Menu_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                menuDto = JsonSerializer.Deserialize<MenuDto>(result.data.ToString());
                await InvokeAsync(StateHasChanged);
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Role_List(new RoleFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                rolesDtoList = JsonSerializer.Deserialize<List<RoleDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task SelectRole(RoleDto roleDto)
    {
        var confirm = await dialog.Confirm("Do you really want to assign this role?", "Assign Role");
        if (confirm != null && (bool)confirm)
        {
            var menuRoleDto = new MenuRoleDto
            {
                fkIdMenu = (Guid)menuDto.id,
                fkIdRole = roleDto.id
            };
            ResultDto result = await fetch.MenuRoles_Insert(menuRoleDto);

            if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadEmployeeData();
                await OnReloadList.InvokeAsync(menuDto);
                await InvokeAsync(StateHasChanged);
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        }
    }

    bool isDisabled(RoleDto roleDto)
    {
        return menuDto.menuRoles.Select(x => x.fkIdRole).Contains(roleDto.id);
    }

    string getCssClass(bool isDisabled)
    {
        return isDisabled ? "cursor: not-allowed;" : "cursor:pointer;";
    }
}
