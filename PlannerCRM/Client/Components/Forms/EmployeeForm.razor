@using System.Text
@layout MainLayout

@attribute [Authorize]

@if (fetch.isBusy)
{
    <Loader />
} else
{

    <RadzenStack JustifyContent="JustifyContent.Center">
        <RadzenCard>
            <RadzenTabs TabPosition="TabPosition.Left">
                <Tabs>
                    <RadzenTabsItem Text="Assigned Roles" Visible="@(IsInsert == false)">
                        <RadzenRow class="mt-3">
                            <RadzenColumn>
                                <RadzenDataGrid @ref="grid"
                                                TItem="EmployeesRolesDto"
                                                Data="@employeeDto.employeesRoles"
                                                PageSize="20"
                                                AllowFiltering="false"
                                                AllowPaging="false"
                                                AllowSorting="true">
                                    <HeaderTemplate>
                                        <RadzenButton Icon="playlist_add_check" Text="New" Click="NewRole"></RadzenButton>
                                    </HeaderTemplate>
                                    <Columns>
                                        <RadzenDataGridColumn TItem="EmployeesRolesDto" Property="@nameof(EmployeesRolesDto.fkIdRoleNavigation.name)" Title="Role Name">
                                            <Template Context="data">
                                                @data.fkIdRoleNavigation.name
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="EmployeesRolesDto" Width="64px">
                                            <Template Context="data">
                                                <RadzenButton Icon="delete" Variant="Variant.Text" IconColor="@Colors.Danger" Click="@(() => RemoveRole(data.fkIdRoleNavigation))"></RadzenButton>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Advanced dynbamic form">
                        <DynamicGrid TItem="@RoleDto"
                                     ItemsList="@employeeDto.employeesRoles.Select(x => x.fkIdRoleNavigation).ToList()"
                                     AllowSelection="false"
                                     AllowUpdate="false"
                                     AllowDelete="false"
                                     AllowInsert="false"
                                     OnReloadList="@(() => OnReloadList.InvokeAsync())" />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
            <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Text="Cancel" Click="Close"></RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Save" Click="Submit"></RadzenButton>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
}

@code
{
    [Parameter] public bool IsInsert { get; set; }
    [Parameter] public EmployeeDto employeeDto { get; set; } = new();
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public EventCallback OnCloseSide { get; set; }

    List<RoleDto> roles = new();
    RadzenDataGrid<EmployeesRolesDto> grid;
    RoleDto assignedRole = new();
    EditContext editContext;
    protected override async Task OnInitializedAsync()
    {
        if (!IsInsert)
        {
            await LoadEmployeeData();
        }
        await LoadRoles();
        editContext = new(employeeDto);
    }

    void Close()
    {
        dialog.Close();
    }

    private async Task LoadEmployeeData()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            var filter = new EmployeeFilterDto() { employeeId = employeeDto.id };

            result = await fetch.Employee_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                employeeDto = JsonSerializer.Deserialize<EmployeeDto>(result.data.ToString());
                await OnReloadList.InvokeAsync();
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }

    async Task NewRole()
    {
        await dialog.OpenAsync("Assign Role", ds =>
        @<Employee_AddRoles employeeDto="@employeeDto" rolesDtoList="@roles" OnReloadList="LoadEmployeeData" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }

    async Task AssignRole()
    {
        try
        {
            if (!employeeDto.employeesRoles.Select(x => x.fkIdRoleNavigation).Equals(assignedRole))
            {
                var filter = new EmployeeFilterDto() { isRemoveRole = false, role = assignedRole, employeeId = employeeDto.id };

                var result = await fetch.Employee_Update(new());

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadEmployeeData();
                    await OnReloadList.InvokeAsync();
                } else
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Success, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task RemoveRole(RoleDto role)
    {
        try
        {
            var filter = new EmployeesRolesFilterDto() { roleId = role.id, employeeId = employeeDto.id };

            var result = await fetch.EmployeesRoles_Delete(filter);

            if (result.hasCompleted && result.messageType == MessageType.Success)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadEmployeeData();
                await OnReloadList.InvokeAsync();
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Error, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task Update()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Employee_Update(employeeDto);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {

            }
            fetch.isBusy = false;
            await InvokeAsync(StateHasChanged);
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Role_List(new RoleFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                roles = JsonSerializer.Deserialize<List<RoleDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task Submit()
    {
        try
        {
            if (editContext.Validate())
            {
                ResultDto result = new ResultDto();
                if (IsInsert)
                {
                    result = await fetch.Employee_Insert(employeeDto);
                } else
                {
                    result = await fetch.Employee_Update(employeeDto);
                }

                if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadEmployeeData();
                    await OnReloadList.InvokeAsync();
                } else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}
