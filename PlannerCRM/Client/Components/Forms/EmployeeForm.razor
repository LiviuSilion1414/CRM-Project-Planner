@using System.Text
@using static PlannerCRM.Shared.Dtos.DtoShared
@layout MainLayout

@attribute [Authorize]

@if (fetch.isBusy)
{
    <Loader />
} else
{
    <RadzenCard class="mt-3 mb-3">
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenText TextStyle="TextStyle.H5"><RadzenLabel Style="font-weight:bold;">Employee Form</RadzenLabel></RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">This form allows you to insert new and update existing data.</RadzenText>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenStack JustifyContent="JustifyContent.Center">
        <RadzenCard>
            <RadzenTabs TabPosition="TabPosition.Left" SelectedIndex="@index">
                <Tabs>
                    <RadzenTabsItem Text="General Details">
                        <DynamicForm TItem="@EmployeeDto"
                                     MetaProperties="@fetch.lookupMetaProperties[typeof(EmployeeDto)]"
                                     Model="@employeeDto"
                                     OnSubmit="@Update">
                        </DynamicForm>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Assigned Roles">
                        <RadzenRow class="mt-3">
                            <RadzenColumn>
                                <DynamicGrid ApiController="@ApiUrl.EMPLOYEES_ROLES_CONTROLLER"
                                             TItem="@EmployeesRolesDto"
                                             AllowInsert="true"
                                             OnInsert="@NewRole"
                                             ItemsList="@employeeDto.employeesRoles.ToList()"
                                             ModelTitle="Employee's Roles"
                                             OnReloadList="LoadEmployeeData"
                                             ShowClear="false"
                                             ShowSearch="false">
                                    <MainColumns>
                                        <RadzenDataGridColumn TItem="@EmployeesRolesDto" Title="Title" Sortable="true" Filterable="false">
                                            <Template Context="data">
                                                @data?.fkIdRoleNavigation?.name
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="@EmployeesRolesDto" Title="Group" Sortable="true" Filterable="false" Width="150px">
                                            <Template Context="data">
                                                @data?.fkIdRoleNavigation?.fkIdGroupRoleNavigation?.title
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </MainColumns>
                                    <ExtraColumns>
                                        <RadzenDataGridColumn TItem="@EmployeesRolesDto" Width="64px" Sortable="false" Filterable="false">
                                            <Template Context="data">
                                                <RadzenButton Icon="delete" Variant="Variant.Text" IconColor="@Colors.Danger" Click="@(() => RemoveRole(data))"></RadzenButton>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </ExtraColumns>
                                </DynamicGrid>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    </RadzenStack>
}

@code
{
    [Parameter] public EmployeeDto employeeDto { get; set; } = new();
    [Parameter] public EventCallback OnReloadList { get; set; }

    int index;

    void Close()
    {
        dialog.Close();
    }

    void GetEmployee(EmployeeDto employeeDtoUpd)
    {
        employeeDto = employeeDtoUpd;
    }

    async Task NewRole()
    {
        await dialog.OpenAsync("Assign Role", ds =>
        @<Employee_AddRoles employeeDto="@employeeDto" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }

    private async Task LoadEmployeeData()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            var filter = new EmployeeFilterDto() { employeeId = employeeDto.id };

            result = await fetch.Employee_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                employeeDto = JsonSerializer.Deserialize<EmployeeDto>(result.data.ToString());
                await InvokeAsync(StateHasChanged);
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }


    async Task RemoveRole(EmployeesRolesDto employeesRolesDto)
    {
        try
        {
            bool? confirm = await dialog.Confirm("Are you really sure you want to permanently delete this role from the employee? The operation is irreversible", "Delete record");

            if (confirm != null && confirm == true)
            {
                var result = await fetch.EmployeesRoles_Delete(employeesRolesDto);

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadEmployeeData();
                    await OnReloadList.InvokeAsync();
                    await InvokeAsync(StateHasChanged);
                } else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Error, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task Update(EmployeeDto employeeDtoUpd)
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Employee_Update(employeeDtoUpd);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {

            }
            fetch.isBusy = false;
            await OnReloadList.InvokeAsync();
            await InvokeAsync(StateHasChanged);
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

}
