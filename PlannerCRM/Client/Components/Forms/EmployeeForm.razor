@layout MainLayout

@attribute [Authorize]

<RadzenStack JustifyContent="JustifyContent.Center">
    <EditForm EditContext="@_context" OnValidSubmit="Submit">
        <RadzenCard>
            <RadzenFieldset Text="Employee">
                <DataAnnotationsValidator />
                <RadzenRow class="mt-3">
                    <RadzenColumn>
                        <RadzenLabel>Name</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn>
                        <InputText class="form-control" @bind-Value="@Model.name" />
                        <ValidationMessage For="@(() => Model.name)" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="mt-3">
                    <RadzenColumn>
                        <RadzenLabel>Surname</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn>
                        <InputText class="form-control" @bind-Value="@Model.surname" />
                        <ValidationMessage For="@(() => Model.surname)" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="mt-3">
                    <RadzenColumn>
                        <RadzenLabel>Email</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn>
                        <InputText class="form-control" @bind-Value="@Model.username" />
                        <ValidationMessage For="@(() => Model.username)" />
                    </RadzenColumn>
                </RadzenRow>
                @if (IsInsert)
                {
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenLabel>Password</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn>
                            <InputText class="form-control" @bind-Value="@Model.newPassword" />
                            <ValidationMessage For="@(() => Model.newPassword)" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenLabel>Is removeable?</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn>
                            <RadzenCheckBox @bind-Value="@Model.isRemoveable" />
                            <ValidationMessage For="@(() => Model.isRemoveable)" />
                        </RadzenColumn>
                    </RadzenRow>
                }
            </RadzenFieldset>
            @if (!IsInsert)
            {
                <RadzenFieldset Text="Roles">
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenLabel>Roles</RadzenLabel>
                            <RadzenDropDown TValue="RoleDto"
                                            Data="@roles.Where(x => !Model.employeesRoles.Select(y => y.fkIdRole).Contains(x.id))"
                                            TextProperty="@nameof(RoleDto.name)"
                                            Change="@AssignRole"
                                            @bind-Value="@assignedRole"
                                            Style="width: 30vw;">
                                <EmptyTemplate>
                                    <RadzenText TextAlign="TextAlign.Center" TextStyle="TextStyle.Body1" class="m-3" Text="No roles avaialable" />
                                </EmptyTemplate>
                            </RadzenDropDown>
                        </RadzenColumn>
                        <RadzenColumn>
                            <RadzenDataGrid @ref="grid"
                                            TItem="EmployeesRoleDto"
                                            Data="@Model.employeesRoles"
                                            PageSize="5"
                                            AllowPaging="true"
                                            AllowSorting="true">
                                <Columns>
                                    <RadzenDataGridColumn TItem="EmployeesRoleDto" Property="@nameof(EmployeesRoleDto.roleName)" Title="Role Name" />
                                    <RadzenDataGridColumn TItem="EmployeesRoleDto" Width="64px">
                                        <Template Context="data">
                                            <RadzenButton Icon="delete" Variant="Variant.Text" IconColor="@Colors.Danger" Click="@(() => RemoveRole(data.fkIdRoleNavigation))"></RadzenButton>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>
            }
            <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Text="Cancel" Click="Close"></RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Save" ButtonType="ButtonType.Submit"></RadzenButton>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>
    </EditForm>
</RadzenStack>

@code
{
    [Parameter] public bool IsInsert { get; set; }
    [Parameter] public EmployeeDto Model { get; set; }
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public EventCallback OnCloseSide { get; set; }

    EditContext _context;
    List<RoleDto> roles = new();
    RadzenDataGrid<EmployeesRoleDto> grid;
    RoleDto assignedRole = new();

    protected override async Task OnInitializedAsync()
    {
        await OnCloseSide.InvokeAsync();
        if (IsInsert)
        {
            Model = new EmployeeDto()
                {
                    employeesRoles = new List<EmployeesRoleDto>()
                };
        }
        _context = new(Model);
        await LoadRoles();
        await LoadEmployeeData();
    }

    void Close()
    {
        dialog.Close();
    }

    private async Task LoadEmployeeData()
    {
        try
        {
            fetch.IsBusy = true;

            var filter = new EmployeeFilterDto() { employeeId = Model.id };

            var result = await execute.Employee_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                Model = JsonSerializer.Deserialize<EmployeeDto>(result.data.ToString());
            }
            fetch.IsBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task AssignRole()
    {
        try
        {
            if (!Model.employeesRoles.Select(x => x.fkIdRoleNavigation).Equals(assignedRole))
            {
                var filter = new EmployeeFilterDto() { isRemoveRole = false, role = assignedRole, employeeId = Model.id };

                var result = await execute.Employee_UpdateRole(filter);

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadEmployeeData();
                    await grid.Reload();
                }
                else
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                }
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Success, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task RemoveRole(RoleDto role)
    {
        try
        {
            var filter = new EmployeeFilterDto() { isRemoveRole = true, role = role, employeeId = Model.id };

            var result = await execute.Employee_UpdateRole(filter);

            if (result.hasCompleted && result.messageType == MessageType.Success)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadEmployeeData();
                await grid.Reload();
            }
            else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Error, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            fetch.IsBusy = true;

            var result = await execute.Role_List(new RoleFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                roles = JsonSerializer.Deserialize<List<RoleDto>>(result.data.ToString());
            }
            fetch.IsBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task Submit()
    {
        try
        {
            if (_context.Validate())
            {
                ResultDto result = new ResultDto();
                if (IsInsert)
                {
                    result = await execute.Employee_Insert(Model);
                }
                else
                {
                    result = await execute.Employee_Update(Model);
                }

                if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await OnReloadList.InvokeAsync();
                }
                else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}
