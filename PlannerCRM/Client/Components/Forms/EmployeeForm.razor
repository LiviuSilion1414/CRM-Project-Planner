@using System.Text
@layout MainLayout

@attribute [Authorize]

@if (fetch.isBusy)
{
    <Loader />
} else
{

    <RadzenStack JustifyContent="JustifyContent.Center">
        <RadzenCard>
            <RadzenTabs>
                <Tabs>
                    <RadzenTabsItem Text="Employee Data">
                        <RadzenFieldset Text="Employee">
                            <RadzenRow class="mt-3">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel>Name</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <InputText class="form-control w-100" @bind-Value="@employeeDto.name" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow class="mt-3">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel>Surname</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <InputText class="form-control w-100" @bind-Value="@employeeDto.surname" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow class="mt-3">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel>Email</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <InputText class="form-control w-25" @bind-Value="@employeeDto.username" />
                                </RadzenColumn>
                            </RadzenRow>

                            @if (IsInsert)
                            {
                                <RadzenRow class="mt-3">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenLabel>Password</RadzenLabel>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="9">
                                        <InputText class="form-control w-25" @bind-Value="@employeeDto.newPassword" type="password" />
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow class="mt-3">
                                    <RadzenColumn Size="12" SizeMD="3">
                                        <RadzenLabel>Confirm Password</RadzenLabel>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeMD="9">
                                        <InputText class="form-control w-25" @bind-Value="@employeeDto.confirmNewPassword" type="password" />
                                    </RadzenColumn>
                                </RadzenRow>
                            }
                            <RadzenRow class="mt-3">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel>Is removeable?</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenCheckBox class="form-control" TriState="false" @bind-Value="@employeeDto.isRemoveable" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Assigned Roles" Visible="@(IsInsert == false)">
                        <RadzenFieldset Text="Roles">
                            <RadzenRow class="mt-3">
                                <RadzenColumn>
                                    <RadzenDataGrid @ref="grid"
                                                    TItem="EmployeesRolesDto"
                                                    Data="@employeeDto.employeesRoles"
                                                    PageSize="20"
                                                    AllowFiltering="false"
                                                    AllowPaging="false"
                                                    AllowSorting="true">
                                        <HeaderTemplate>
                                            <RadzenButton Icon="playlist_add_check" Text="New" Click="New"></RadzenButton>
                                        </HeaderTemplate>
                                        <Columns>
                                            <RadzenDataGridColumn TItem="EmployeesRolesDto" Property="@nameof(EmployeesRolesDto.fkIdRoleNavigation.name)" Title="Role Name">
                                                <Template Context="data">
                                                    @data.fkIdRoleNavigation.name
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="EmployeesRolesDto" Width="64px">
                                                <Template Context="data">
                                                    <RadzenButton Icon="delete" Variant="Variant.Text" IconColor="@Colors.Danger" Click="@(() => RemoveRole(data.fkIdRoleNavigation))"></RadzenButton>
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenFieldset>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
            <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Text="Cancel" Click="Close"></RadzenButton>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Save" Click="Submit"></RadzenButton>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>
    </RadzenStack>
}

@code
{
    [Parameter] public bool IsInsert { get; set; }
    [Parameter] public EmployeeDto employeeDto { get; set; } = new();
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public EventCallback OnCloseSide { get; set; }

    List<RoleDto> roles = new();
    RadzenDataGrid<EmployeesRolesDto> grid;
    RoleDto assignedRole = new();

    protected override async Task OnInitializedAsync()
    {
        if (!IsInsert)
        {
            await LoadEmployeeData();
        }
        await LoadRoles();
    }

    void Close()
    {
        dialog.Close();
    }

    private async Task LoadEmployeeData()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            var filter = new EmployeeFilterDto() { employeeId = employeeDto.id };

            result = await fetch.Employee_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                employeeDto = JsonSerializer.Deserialize<EmployeeDto>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }

    async Task New()
    {
        await dialog.OpenAsync("Assign Role", ds => @<Employee_AddRoles employeeDto="@employeeDto" rolesDtoList="@roles" OnReloadList="LoadEmployeeData" />);
    }

    async Task AssignRole()
    {
        try
        {
            if (!employeeDto.employeesRoles.Select(x => x.fkIdRoleNavigation).Equals(assignedRole))
            {
                var filter = new EmployeeFilterDto() { isRemoveRole = false, role = assignedRole, employeeId = employeeDto.id };

                var result = await fetch.Employee_Update(new());

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadEmployeeData();
                    await grid.Reload();
                } else
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Success, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task RemoveRole(RoleDto role)
    {
        try
        {
            var filter = new EmployeesRolesFilterDto() { roleId = role.id, employeeId = employeeDto.id };

            var result = await fetch.EmployeesRoles_Delete(filter);

            if (result.hasCompleted && result.messageType == MessageType.Success)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadEmployeeData();
                await grid.Reload();
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Error, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Role_List(new RoleFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                roles = JsonSerializer.Deserialize<List<RoleDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task Submit()
    {
        try
        {
            if (IsValid())
            {
                ResultDto result = new ResultDto();
                if (IsInsert)
                {
                    result = await fetch.Employee_Insert(employeeDto);
                } else
                {
                    result = await fetch.Employee_Update(employeeDto);
                }

                if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await OnReloadList.InvokeAsync();
                } else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }


    bool IsValid()
    {
        var isValid = false;
        var errorsList = new List<string>();

        if (string.IsNullOrEmpty(employeeDto.name))
            errorsList.Add("Name field is required");

        if (string.IsNullOrEmpty(employeeDto.surname))
            errorsList.Add("Surname field is required");

        if (string.IsNullOrEmpty(employeeDto.username))
            errorsList.Add("Username field is required");
        else if (!new EmailAddressAttribute().IsValid(employeeDto.username))
            errorsList.Add("Username field should be an email address");

        if (employeeDto.isRemoveable == null)
            errorsList.Add("\"Is removeable\" field is required");

        if (IsInsert)
        {
            if (string.IsNullOrEmpty(employeeDto.newPassword))
                errorsList.Add("New password field is required");

            if (string.IsNullOrEmpty(employeeDto.confirmNewPassword))
                errorsList.Add("Confirm new password field is required");

            if (!string.IsNullOrEmpty(employeeDto.newPassword) && !string.IsNullOrEmpty(employeeDto.confirmNewPassword))
            {
                if (employeeDto.newPassword.Contains("\\s") || employeeDto.confirmNewPassword.Contains("\\s"))
                    errorsList.Add("New password and Confirm new password fields must not have empty spaces");

                if (employeeDto.newPassword.Length != employeeDto.confirmNewPassword.Length)
                    errorsList.Add("New password and Confirm new password fields must have same lengths");

                else if (employeeDto.newPassword.Length == employeeDto.confirmNewPassword.Length && (employeeDto.newPassword.Length <= 8 || employeeDto.confirmNewPassword.Length <= 8))
                    errorsList.Add("Both New password and Confirm new password fields must be at least 8 characters");

                if (!employeeDto.newPassword.Equals(employeeDto.confirmNewPassword))
                    errorsList.Add("New password and Confirm new password fields must be equal");
            }
        }


        isValid = !errorsList.Any();

        if (isValid)
            return true;

        foreach (var err in errorsList)
        {
            var notificationMessage = new NotificationMessage()
            {
                Severity = NotificationSeverity.Error,
                Summary = "Attention!!!",
                Duration = 4000,
                ShowProgress = true,
                Detail = err
            };

            notification.Notify(notificationMessage);
        }

        return false;
    }
}
