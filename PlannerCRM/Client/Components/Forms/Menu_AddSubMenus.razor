
<RadzenCard>
    <RadzenDataGrid TItem="@MenuDto"
                    Data="@menuDtoList.Where(x => x.isMenu != null && (bool)x.isMenu && x.idParent != menuParent.id)"
                    AllowSorting="false"
                    AllowFiltering="false">
        <Columns>
            <RadzenDataGridColumn Property="@(nameof(MenuDto.title))" Title="Title" />
            <RadzenDataGridColumn Property="@(nameof(MenuDto.path))" Title="Path" />
            <RadzenDataGridColumn Width="55px">
                <Template Context="data">
                    <RadzenButton Icon="add"
                                  Click="@(() => SelectMenu(data))"
                                  Style="@(getCssClass(isDisabled(data)))"
                                  Disabled="@isDisabled(data)" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
        <RadzenRow>
            <RadzenColumn Size="6">
                <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Text="Cancel" Click="dialog.Close"></RadzenButton>
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
</RadzenCard>

@code
{
    [Parameter] public MenuDto menuParent { get; set; }
    [Parameter] public EventCallback<MenuDto> OnReloadList { get; set; }
    [Parameter] public List<MenuDto> menuDtoList { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadMenuList();
    }

    private async Task LoadMenuData()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            var filter = new MenuFilterDto() { id = menuParent.id };

            result = await fetch.Menu_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                menuParent = JsonSerializer.Deserialize<MenuDto>(result.data.ToString());
                await InvokeAsync(StateHasChanged);
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }

    private async Task LoadMenuList()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Menu_List(new MenuFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                menuDtoList = JsonSerializer.Deserialize<List<MenuDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task SelectMenu(MenuDto subMenu)
    {
        var confirm = await dialog.Confirm("Do you really want to assign this sub-menu?", "Assign Sub-Menu");
        if (confirm != null && (bool)confirm)
        {
            subMenu.idParent = menuParent.id;
            subMenu.menuRoles = null;
            ResultDto result = await fetch.Menu_Update(subMenu);

            if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadMenuData();
                await OnReloadList.InvokeAsync(menuParent);
                await InvokeAsync(StateHasChanged);
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        }
    }

    bool isDisabled(MenuDto selectedSubMenu)
    {
        return menuDtoList.Select(x => x.idParent).Contains(selectedSubMenu.id);
    }

    string getCssClass(bool isDisabled)
    {
        return isDisabled ? "cursor: not-allowed;" : "cursor:pointer;";
    }
}
