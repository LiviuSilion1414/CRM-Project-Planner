<RadzenStack>
    <EditForm EditContext="@_context" OnValidSubmit="OnSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <RadzenFieldset Text="Activity Info">
            <RadzenRow class="mt-3">
                <RadzenColumn>
                    <RadzenLabel>Work Order</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenTextBox Name="Name" @bind-Value=@WorkOrder.name  Disabled="true" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow class="mt-3">
                <RadzenColumn>
                    <RadzenLabel Text="Activity" />
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenTextBox Name="Name" @bind-Value=@Activity.name Disabled="true" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset Text="Work time">
            <RadzenRow class="mt-3">
                <RadzenColumn>
                    <RadzenLabel Text="Hours" />
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenNumeric @bind-Value=@Model.hours />
                    <ValidationMessage For="@(() => Model.hours)" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenStack class="mt-3" AlignItems="AlignItems.Center">
            <RadzenRow>
                <RadzenColumn>
                    <RadzenButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Info" Text="Close" Click="Close"></RadzenButton>
                    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Submit"></RadzenButton>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </EditForm>
</RadzenStack>

@code
{
    [Parameter] public ActivityDto Activity { get; set; }
    [Parameter] public WorkOrderDto WorkOrder { get; set; }
    [Parameter] public DateTime? StartDate { get; set; }
    [Parameter] public DateTime? EndDate { get; set; }
    [Parameter] public bool IsInsert { get; set; }
    [Parameter] public WorkTimeDto Model { get; set; }
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public DialogService Ds { get; set; }

    EditContext _context;

    protected override async Task OnInitializedAsync()
    {
        if (IsInsert)
        {
            Model = new();
        }

        if (StartDate != null && EndDate != null)
        {
            // Model.startDate = (DateTime)StartDate;
            // Model.endDate = (DateTime)EndDate;
        }
        else
        {
            // Model.startDate = DateTime.Now;
            // Model.endDate = DateTime.Now;
        }

        _context = new(Model);
        Model.fkIdWorkOrder = WorkOrder.id;
        Model.fkIdActivity = Activity.id;
        //Model.fkid = Guid.Parse((await auth.GetAuthenticationStateAsync()).User.Claims.First(x => x.Type == CustomClaimTypes.Guid).Value);
    }

    private async Task OnSubmit()
    {
        try
        {
            fetch.IsBusy = true;

            var result = await execute.WorkTime_Insert(Model);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
            }
            fetch.IsBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    void Close()
    {
        Ds.Close();
    }
}