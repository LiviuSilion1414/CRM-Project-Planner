@using System.Text
@using static PlannerCRM.Shared.Dtos.DtoShared
@layout MainLayout

@attribute [Authorize]

@if (fetch.isBusy)
{
    <Loader />
} else
{
    <RadzenCard class="mt-3 mb-3">
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenText TextStyle="TextStyle.H5"><RadzenLabel Style="font-weight:bold;">Menu Form</RadzenLabel></RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">This form allows you to insert new and update existing data.</RadzenText>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <RadzenStack JustifyContent="JustifyContent.Center">
        <RadzenCard>
            <RadzenTabs TabPosition="TabPosition.Left" SelectedIndex="@index">
                <Tabs>
                    <RadzenTabsItem Text="General Details">
                        <DynamicForm TItem="@MenuDto"
                                     MetaProperties="@fetch.lookupMetaProperties[typeof(MenuDto)]"
                                     Model="@menuDto"
                                     OnSubmit="@Update">
                        </DynamicForm>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Assigned Roles">
                        <RadzenRow class="mt-3">
                            <RadzenColumn>
                                <DynamicGrid ApiController="@ApiUrl.MENU_ROLE_CONTROLLER"
                                             TItem="@MenuRoleDto"
                                             AllowInsert="true"
                                             OnInsert="@NewRole"
                                             ItemsList="@menuDto.menuRoles.ToList()"
                                             ModelTitle="Menu's Roles"
                                             OnReloadList="LoadMenuData"
                                             ShowClear="false"
                                             ShowSearch="false">
                                    <MainColumns>
                                        <RadzenDataGridColumn TItem="@MenuRoleDto" Title="Title" Sortable="true" Filterable="false">
                                            <Template Context="data">
                                                @data?.fkIdRoleNavigation?.name
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="@MenuRoleDto" Title="Group" Sortable="true" Filterable="false" Width="150px">
                                            <Template Context="data">
                                                @data?.fkIdRoleNavigation?.fkIdGroupRoleNavigation?.title
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </MainColumns>
                                    <ExtraColumns>
                                        <RadzenDataGridColumn TItem="@MenuRoleDto" Width="64px" Sortable="false" Filterable="false">
                                            <Template Context="data">
                                                <RadzenButton Icon="delete" Variant="Variant.Text" IconColor="@Colors.Danger" Click="@(() => RemoveRole(data))"></RadzenButton>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </ExtraColumns>
                                </DynamicGrid>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Assigned Sub Menu's">
                        <RadzenRow class="mt-3">
                            <RadzenColumn>
                                <DynamicGrid ApiController="@ApiUrl.MENU_CONTROLLER"
                                             TItem="@MenuDto"
                                             AllowInsert="true"
                                             OnInsert="@NewSubMenu"
                                             ItemsList="@menuDtoList.Where(x => x.idParent == menuDto.id).ToList()"
                                             ModelTitle="Sub Menu's"
                                             OnReloadList="LoadMenuData"
                                             ShowClear="false"
                                             ShowSearch="false">
                                    <MainColumns>
                                        <RadzenDataGridColumn TItem="@MenuDto" Title="Title" Sortable="true" Filterable="false">
                                            <Template Context="data">
                                                @data?.title
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn TItem="@MenuDto" Title="Path" Sortable="true" Filterable="false" Width="150px">
                                            <Template Context="data">
                                                @data?.path
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </MainColumns>
                                    <ExtraColumns>
                                        <RadzenDataGridColumn TItem="@MenuDto" Width="64px" Sortable="false" Filterable="false">
                                            <Template Context="data">
                                                <RadzenButton Icon="delete" Variant="Variant.Text" IconColor="@Colors.Danger" Click="@(() => RemoveSubMenu(data))"></RadzenButton>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </ExtraColumns>
                                </DynamicGrid>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </RadzenCard>
    </RadzenStack>
}

@code
{
    [Parameter] public MenuDto menuDto { get; set; } = new();
    [Parameter] public EventCallback OnReloadList { get; set; }

    int index;

    List<MenuDto> menuDtoList = new List<MenuDto>();
    List<RoleDto> rolesDtoList = new List<RoleDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadMenuList();
        await LoadRoleList();
    }

    void Close()
    {
        dialog.Close();
    }

    void GetMenu(MenuDto menuDtoUpd)
    {
        menuDto = menuDtoUpd;
    }

    async Task Reload()
    {
        await OnReloadList.InvokeAsync();
    }

    async Task NewRole()
    {
        await dialog.OpenAsync("Assign Role", ds =>
        @<Menu_AddRoles menuDto="@menuDto" rolesDtoList="@rolesDtoList" OnReloadList="Reload" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }

    async Task NewSubMenu()
    {
        await dialog.OpenAsync("Assign Sub-Menu", ds =>
        @<Menu_AddSubMenus menuParent="@menuDto" menuDtoList="@menuDtoList" OnReloadList="Reload" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }

    private async Task LoadMenuList()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Menu_List(new MenuFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                menuDtoList = JsonSerializer.Deserialize<List<MenuDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task LoadRoleList()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Role_List(new RoleFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                rolesDtoList = JsonSerializer.Deserialize<List<RoleDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task LoadMenuData()
    {
        var result = new ResultDto();
        try
        {
            fetch.isBusy = true;

            var filter = new MenuFilterDto() { id = menuDto.id };

            result = await fetch.Menu_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                menuDto = JsonSerializer.Deserialize<MenuDto>(result.data.ToString());
                await InvokeAsync(StateHasChanged);
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, result.message, null, 4000);
        }
    }


    async Task RemoveSubMenu(MenuDto menuDtoToDelete)
    {
        try
        {
            bool? confirm = await dialog.Confirm("Are you really sure you want to permanently remove the sub-menu? The operation is irreversible", "Delete record");

            if (confirm != null && confirm == true)
            {
                menuDtoToDelete.idParent = null;
                menuDtoToDelete.menuRoles = null;
                var result = await fetch.Menu_Update(menuDtoToDelete);

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadMenuData();
                    await Reload();
                    await InvokeAsync(StateHasChanged);
                } else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Error, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task RemoveRole(MenuRoleDto menuRoleDto)
    {
        try
        {
            bool? confirm = await dialog.Confirm("Are you really sure you want to permanently delete this role from the employee? The operation is irreversible", "Delete record");

            if (confirm != null && confirm == true)
            {
                var result = await fetch.MenuRoles_Delete(menuRoleDto);

                if (result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadMenuData();
                    await Reload();
                    await InvokeAsync(StateHasChanged);
                } else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Error, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task Update(MenuDto menuDtoUpd)
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Menu_Update(menuDtoUpd);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {

            }
            fetch.isBusy = false;
            await OnReloadList.InvokeAsync();
            await InvokeAsync(StateHasChanged);
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

}
