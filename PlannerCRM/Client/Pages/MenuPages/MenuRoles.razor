@page "/menu-roles"

@layout MainLayout
@attribute [Authorize]

@if ((isInsert || isEdit || isView) && _selectedMenuRole is not null)
{
    <RadzenRow>
        <RadzenColumn SizeLG="12">
            <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Primary" Text="Back to list" Click="LoadData"></RadzenButton>
        </RadzenColumn>
    </RadzenRow>
}

@if (isInsert && _selectedMenuRole is not null)
{
    <MenuRoleForm Model="@_selectedMenuRole" IsInsert="true" OnReloadList="LoadData" />
} else if (isEdit && _selectedMenuRole is not null)
{
    <MenuRoleForm Model="@_selectedMenuRole" IsInsert="false" OnReloadList="LoadData" />
} else if (isView && _selectedMenuRole is not null)
{
    <MenuRoleDialog SelectedMenuRole="_selectedMenuRole" OnReloadList="LoadData" />
} else
{

    <RadzenDataGrid Data="@menuRoleList"
                    TItem="MenuRoleDto" 
                    AllowFiltering="false" 
                    AllowPaging="false" AllowSorting="true">
        <EmptyTemplate>
            <RadzenText Text="No data found" />
        </EmptyTemplate>
        <HeaderTemplate>
            <RadzenButton Icon="add_circle_outline" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Text="Add" Click="@OnAdd"></RadzenButton>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="MenuRoleDto" Title="Title">
                <Template Context="data">
                    @data.fkIdMenuNavigation.title
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MenuRoleDto" Title="Path">
                <Template Context="data">
                    <RadzenLink Path="@data.fkIdMenuNavigation.path" Text="@data.fkIdMenuNavigation.path" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MenuRoleDto" Title="Icon" Width="120px" TextAlign="TextAlign.Center">
                <Template Context="data">
                    <RadzenIcon Icon="@data.fkIdMenuNavigation.icon" IconStyle="IconStyle.Primary" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MenuRoleDto" Title="N. authorized" Width="150px" TextAlign="TextAlign.Center">
                <Template Context="data">
                    @data.fkIdRoleNavigation.employeeRolesList.Where(x => x.fkIdRole == data.fkIdRole).Count()
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MenuRoleDto" Width="64px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                <Template Context="data">
                    <RadzenButton Icon="open_in_new" Click="@(() => OnEdit(data))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="MenuRoleDto" Width="64px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                <Template Context="data">
                    @if (!data.fkIdRoleNavigation.employeeRolesList.Any())
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" IconColor="danger" Click="@(() => OnDelete(data))" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

}

@code
{
    List<MenuRoleDto> menuRoleList = new List<MenuRoleDto>();
    List<MenuDto> menuList = new List<MenuDto>();
    List<RoleDto> roleList = new List<RoleDto>();
    List<EmployeeDto> employeeLis = new List<EmployeeDto>();

    private MenuRoleDto? _selectedMenuRole = new();
    private bool isInsert = false;
    private bool isView = false;
    private bool isEdit = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private void ResetFlags()
    {
        isView = false;
        isEdit = false;
        isInsert = false;
        _selectedMenuRole = null;
    }

    void OnAdd()
    {
        _selectedMenuRole = new();
        isInsert = !isInsert;
    }

    void OnEdit(MenuRoleDto menuRole)
    {
        _selectedMenuRole = menuRole;
        isEdit = !isEdit;
    }

    void OnSelect(MenuRoleDto menuRole)
    {
        _selectedMenuRole = menuRole;
        isView = !isView;
    }

    async Task LoadData()
    {
        ResetFlags();
        await LoadMenuRoles();
        await LoadRoles();
        StateHasChanged();
    }

    private async Task LoadRoles()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Role_List(new RoleFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                roleList = JsonSerializer.Deserialize<List<RoleDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch (Exception exc)
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    public async Task LoadMenuRoles()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Menu_Role_List(new MenuRoleFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                menuRoleList = JsonSerializer.Deserialize<List<MenuRoleDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch (Exception exc)
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    public async Task OnDelete(MenuRoleDto menuRole)
    {
        try
        {
            var confirm = await dialog.Confirm("Do you want to remove this item?", "Delete menu role");

            if (confirm != null && (bool)confirm)
            {
                MenuRoleFilterDto filterDto = new MenuRoleFilterDto()
                {
                    id = menuRole.id
                };

                fetch.isBusy = true;

                var result = await fetch.Menu_Role_Delete(filterDto);

                if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, "", 4000);
                }
                fetch.isBusy = false;
            }
        } catch (Exception exc)
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task ShowRecord(MenuRoleDto menuRoleDto)
    {

    }
}