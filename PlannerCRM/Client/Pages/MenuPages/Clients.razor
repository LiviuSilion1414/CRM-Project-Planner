@page "/clients"
@using static PlannerCRM.Shared.Dtos.DtoShared

<h3>Clients</h3>
<PageTitle>Clients</PageTitle>

@if (fetch.isBusy)
{
    <Loader />
}
else
{
    <RadzenCard class="mb-3">
        <RadzenRow class="mt-3">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>Name</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox class="form-control" Style="min-width: 20vw;" @bind-Value="@name" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>Fiscal Code</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox class="form-control" Style="min-width: 20vw;" @bind-Value="@fiscalCode" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>Email</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox class="form-control" Style="min-width: 20vw;" @bind-Value="@email" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>VAT Number</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox class="form-control" Style="min-width: 20vw;" @bind-Value="@vatNumber" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <DynamicGrid ApiController="@ApiUrl.CLIENT_CONTROLLER"
                    TItem="@FirmClientDto"
                    ItemsList="@_clients"
                    ModelTitle="Client"
                    OnReloadList="LoadData"
                    OnReset="@ResetData" />
}

@code
{
    private List<FirmClientDto> _clients = new List<FirmClientDto>();

    string name = string.Empty;
    string fiscalCode = string.Empty;
    string email = string.Empty;
    string vatNumber = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task ResetData()
    {
        name = null;
        fiscalCode = null;
        vatNumber = null;
        email = null;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new FirmClientFilterDto
            {
                name = name,
                fiscalCode = fiscalCode,
                vatNumber = vatNumber,
                email = email
            };

            var result = await fetch.FirmClient_List(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                _clients = JsonSerializer.Deserialize<List<FirmClientDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}