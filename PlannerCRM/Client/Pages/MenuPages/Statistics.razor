@page "/statistics"

@attribute [Authorize(Roles = "Admin")]

@if (fetch.isBusy)
{
    <Loader />
}
else
{
    <RadzenCard class="m-3">
        <RadzenStack>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenText TextStyle="TextStyle.DisplayH6">All records</RadzenText>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="10">
                    <RadzenLabel>Work Orders</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    @workOrders.Count
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="10">
                    <RadzenLabel>Activities</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    @activities.Count
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="10">
                    <RadzenLabel>Clients</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    @clients.Count
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="10">
                    <RadzenLabel>Employees</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    @employees.Count
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="10">
                    <RadzenLabel>Work Times</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    @workTimes.Count
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </RadzenCard>
}

@code
{
    List<ActivityDto> activities = new();
    List<WorkOrderDto> workOrders = new();
    List<FirmClientDto> clients = new();
    List<EmployeeDto> employees = new();
    List<WorkTimeDto> workTimes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        fetch.isBusy = true;

        await LoadActivities();
        await LoadWorkOrders();
        await LoadClients();
        await LoadEmployees();
        await LoadWorkTimes();

        fetch.isBusy = false;
    }

    async Task LoadWorkOrders()
    {
        try
        {
            var result = await fetch.WorkOrder_List(new WorkOrderFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                workOrders = JsonSerializer.Deserialize<List<WorkOrderDto>>(result.data.ToString());
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task LoadClients()
    {
        try
        {
            var result = await fetch.FirmClient_List(new FirmClientFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                clients = JsonSerializer.Deserialize<List<FirmClientDto>>(result.data.ToString());
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task LoadEmployees()
    {
        try
        {
            var result = await fetch.Employee_List(new EmployeeFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                employees = JsonSerializer.Deserialize<List<EmployeeDto>>(result.data.ToString());
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task LoadWorkTimes()
    {
        try
        {
            WorkTimeFilterDto workTimeFilterDto = new WorkTimeFilterDto
            {
                employeeId = fetch.currentUser.id,
            };

            var result = await fetch.WorkTime_FindAssociatedWorkTimesByEmployeeId(workTimeFilterDto);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                workTimes = JsonSerializer.Deserialize<List<WorkTimeDto>>(result.data.ToString());
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task LoadActivities()
    {
        try
        {
            var result = await fetch.Activity_List(new ActivityFilterDto());
            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                activities = JsonSerializer.Deserialize<List<ActivityDto>>(result.data.ToString());
            }
        }
        catch (Exception ex)
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}
