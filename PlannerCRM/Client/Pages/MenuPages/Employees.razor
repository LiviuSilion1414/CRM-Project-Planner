@page "/employees"
@layout MainLayout

@attribute [Authorize(Roles = "Admin")]

<h3>Employees</h3>
<PageTitle>Employees</PageTitle>

@if (fetch.isBusy)
{
    <Loader />
} else
{

    <RadzenCard class="mb-3">
        <RadzenRow class="mt-3">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>Role</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="Role" AllowFloatingLabel="false">
                    <RadzenDropDown TValue="Guid ?"
                                    class="form-control"
                                    Data="@fetch.rolesList"
                                    AllowFiltering="true"
                                    AllowClear="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    TextProperty="@nameof(RoleDto.name)"
                                    ValueProperty="@nameof(RoleDto.id)"
                                    @bind-Value="@roleId" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>Name</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox class="form-control" Style="min-width: 20vw;" @bind-Value="@name" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>Surname</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox class="form-control" Style="min-width: 20vw;" @bind-Value="@surname" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenLabel>Username</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenTextBox class="form-control" Style="min-width: 20vw;" @bind-Value="@username" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <DynamicGrid TItem="@EmployeeDto"
                 ItemsList="@_employees"
                 ModelTitle="Employees"
                 OnReloadList="LoadData"
                 OnReset="@ResetData"
                 OnAdd="@OnAdd"
                 OnDelete="@OnDelete"
                 OnEdit="@OnEdit" />
}

@code
{
    IEnumerable<int> pageSizeOptions = new[] { 20, 50, 100 };
    private List<EmployeeDto> _employees = new();

    private string? name = string.Empty;
    private string? surname = string.Empty;
    private string? username = string.Empty;

    private Guid? roleId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task ResetData()
    {
        name = null;
        surname = null;
        username = null;
        roleId = null;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new EmployeeFilterDto
            {
                name = name,
                surname = surname,
                username = username,
                roleId = roleId
            };

            var result = await fetch.Employee_List(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                _employees = JsonSerializer.Deserialize<List<EmployeeDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch (Exception exc)
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task OnAdd()
    {
        EmployeeDto employeeDto = new EmployeeDto();

        await dialog.OpenAsync("New Employee", ds =>
        @<DynamicForm TItem="@EmployeeDto" Model="@employeeDto" OnSubmit="@Submit">
            <TopContent>
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="12">
                        <RadzenText TextStyle="TextStyle.H5"><RadzenLabel Style="font-weight:bold;">Employee Form</RadzenLabel></RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">This form allows you to insert new and update existing employees.</RadzenText>
                    </RadzenColumn>
                </RadzenRow>
            </TopContent>
        </DynamicForm> ,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }


    async Task Submit(EmployeeDto employeeDto)
    {
        try
        {
            bool isInsert = employeeDto.id == null || employeeDto.id == Guid.Empty;

            ResultDto result = new ResultDto();
            if (isInsert)
            {
                result = await fetch.Employee_Insert(employeeDto);
            } else
            {
                result = await fetch.Employee_Update(employeeDto);
            }

            if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadData();
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task OnEdit(EmployeeDto employeeDto)
    {
        await dialog.OpenAsync("Employee Form", ds =>
        @<EmployeeForm employeeDto="@employeeDto" IsInsert="false" /> ,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }

    private async Task OnDelete(EmployeeDto employee)
    {
        try
        {
            var filter = new EmployeeFilterDto() { employeeId = employee.id };

            var result = await fetch.Employee_Delete(filter);

            if (result.hasCompleted && result.messageType == MessageType.Success)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadData();
            } else
            {
                notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}