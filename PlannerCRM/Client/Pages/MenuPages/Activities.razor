@page "/activities"
@using static PlannerCRM.Shared.Dtos.DtoShared

<PageContainer PageTitle="Activities"
               Description="Here you can handle all activities assigned">
    <ChildContent>
        <RadzenCard class="mb-3">
            <RadzenRow JustifyContent="JustifyContent.Stretch">
                <RadzenColumn>
                    <RadzenFormField Text="Title" AllowFloatingLabel="false">
                        <RadzenTextBox class="form-control" Style="min-width: 30vw;" @bind-Value="@title" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <DynamicGrid ApiController="@ApiUrl.ACTIVITY_CONTROLLER"
                     AllowInsert="true"
                     AllowUpdate="true"
                     AllowDelete="true"
                     TItem="@ActivityDto"
                     ItemsList="@_activities"
                     ModelTitle="Activity"
                     OnAdvancedUpdate="AdvancedUpdate"
                     OnReloadList="LoadData" />
    </ChildContent>
</PageContainer>

@code {
    private List<ActivityDto> _activities = new();

    private string title;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task ResetData()
    {
        title = null;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new ActivityFilterDto
            {
                searchQuery = title
            };

            var result = await fetch.Activity_List(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                _activities = JsonSerializer.Deserialize<List<ActivityDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task AdvancedUpdate(ActivityDto item)
    {
        await dialog.OpenAsync($"Advanced editing", ds =>
        @<ActivityForm activityDto="@item" OnReloadList="LoadData" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }
}
