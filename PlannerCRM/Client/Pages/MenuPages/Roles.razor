@page "/roles"
@using static PlannerCRM.Shared.Dtos.DtoShared



<h3>Roles</h3>
<PageTitle>Roles</PageTitle>

<RadzenCard class="mb-3">
    <RadzenRow JustifyContent="JustifyContent.Stretch">
        <RadzenColumn>
            <RadzenFormField Text="Role Name" AllowFloatingLabel="false">
                <RadzenTextBox class="form-control" Style="min-width: 30vw;" @bind-Value="@query" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn>
            <RadzenButton Icon="search_off" ButtonStyle="ButtonStyle.Info" Variant="Variant.Filled" Text="Reset" Click="@ResetData"></RadzenButton>
            <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled" Text="Search" Click="@LoadData"></RadzenButton>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

<RadzenDataGrid @ref="grid"
                TItem="RoleDto"
                Data="roles"
                EditMode="DataGridEditMode.Single"
                SelectionMode="DataGridSelectionMode.Single"
                AllowSorting="true"
                RowCreate="@HandleRole"
                RowUpdate="@HandleRole">
    <HeaderTemplate>
        <RadzenButton Icon="add_circle_outline"
                      ButtonStyle="ButtonStyle.Primary"
                      Variant="Variant.Filled"
                      Text="New"
                      Click="@AddRow"></RadzenButton>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn TItem="RoleDto" Property="@nameof(RoleDto.name)" Title="Role">
            <Template Context="data">
                @data.name
            </Template>
            <EditTemplate Context="edit">
                <RadzenTextBox @bind-Value="edit.name" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RoleDto" Property="@nameof(RoleDto.fkIdGroupRoleNavigation.title)" Title="Group" TextAlign="TextAlign.Center">
            <Template Context="data">
                @data?.fkIdGroupRoleNavigation?.title
            </Template>
            <EditTemplate Context="edit">
                <RadzenDropDown TValue="Guid ?" @bind-Value="edit.fkIdGroupRole" Data="@groupRoles" TextProperty="title" ValueProperty="id" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RoleDto" Title="Linked Employees" TextAlign="TextAlign.Center">
            <Template Context="data">
                <RadzenButton Click="@(() => ViewEmployeeList(data))">
                    @(data.employeeRolesList.Count)

                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RoleDto" Title="Linked Menu's" TextAlign="TextAlign.Center">
            <Template Context="data">
                <RadzenButton Click="@(() => ViewMenuList(data))">
                    @(data.menuRoleList.Count)

                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="RoleDto" Width="200px">
            <Template Context="data">
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(data))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="data">
                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => HandleRole(data))" aria-label="Save" />
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelRow(data))" aria-label="Cancel" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code
{
    RadzenDataGrid<RoleDto> grid;
    List<RoleDto> roles = new();
    List<GroupRoleDto> groupRoles = new();

    string query = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task ResetData()
    {
        query = string.Empty;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new RoleFilterDto
            {
                searchQuery = query
            };

            var result = await fetch.Role_List(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                roles = JsonSerializer.Deserialize<List<RoleDto>>(result.data.ToString());
            }

            result = await fetch.GroupRoles_List(new());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                groupRoles = JsonSerializer.Deserialize<List<GroupRoleDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    void EditRow(RoleDto role)
    {
        grid.EditRow(role);
    }

    void CancelRow(RoleDto role)
    {
        grid.CancelEditRow(role);
    }

    void AddRow()
    {
        RoleDto role = new RoleDto();
        grid.InsertRow(role);
    }

    private async Task HandleRole(RoleDto model)
    {
        try
        {
            var result = new ResultDto();

            if (model.id != Guid.Empty)
            {
                result = await fetch.Role_Update(model);
            } else
            {
                result = await fetch.Role_Insert(model);
            }

            if (result.hasCompleted)
            {
                notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                await LoadData();
            }
            CancelRow(model);
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task ViewMenuList(RoleDto roleDto)
    {
        await dialog.OpenAsync("Menu role", ds =>
            @<DynamicGrid TItem="@MenuDto" 
                          ItemsList="@roleDto.menuRoleList.Select(x => x.fkIdMenuNavigation).ToList()" 
                          AllowUpdate="false"
                          AllowDelete="false"
                          AllowInsert="false"
                          OnReloadList="LoadData">
            <ExtraColumns>
                <RadzenDataGridColumn TItem="@MenuDto" Title="Icon best" Width="64px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <RadzenIcon Icon="@data.icon" />
                    </Template>
                </RadzenDataGridColumn>
            </ExtraColumns>
        </DynamicGrid>
    ,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%"
        });
    }

    async Task ViewEmployeeList(RoleDto roleDto)
    {
        await dialog.OpenAsync("Employee role", ds =>
            @<DynamicGrid TItem="@EmployeeDto"
                          ItemsList="@roleDto.employeeRolesList.Select(x => x.fkIdEmployeeNavigation).ToList()"
                          AllowUpdate="false"
                          AllowDelete="false"
                          AllowInsert="false"
                          OnReloadList="LoadData"/>,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%"
        });
    }

    private async Task OnAdd()
    {
        await dialog.OpenAsync("Add new role", ds =>
            @<RoleForm IsInsert=true OnReloadList="LoadData" />,
        new DialogOptions
        {
            Width = "30%",
            Height = "40%"
        });
    }

    private async Task OnEdit(RoleDto role)
    {
        await dialog.OpenAsync("UPDATE role", ds =>
            @<RoleForm Model="@role" IsInsert=false OnReloadList="LoadData" />,
        new DialogOptions
        {
            Width = "30%",
            Height = "40%"
        });
    }


    private async Task DeleteRole(RoleDto role)
    {
        try
        {
            if ((await dialog.Confirm("Do you really want to remove this role?. This action cannot be reversed.", "DELETE role")).Value)
            {
                var filter = new RoleFilterDto() { roleId = role.id };

                var result = await fetch.Role_Delete(filter);

                if (result.hasCompleted)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await LoadData();
                }
            }
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

}
