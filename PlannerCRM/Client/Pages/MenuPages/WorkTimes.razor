@page "/workTimes"
@using System.Security.Claims

<RadzenScheduler TItem="WorkTimeDto"
                 Style="height: 80vh;"
                 Data=@_workTimes
                 Culture="CultureInfo.InvariantCulture"
                 SlotSelect="@OnAdd"
                 SelectedIndex="1"
                 StartProperty="@nameof(WorkTimeDto.creationDate)"
                 EndProperty="@nameof(WorkTimeDto.creationDate)"
                 TextProperty="@nameof(WorkTimeDto.hoursString)">
    <RadzenWeekView />
    <RadzenMonthView />
</RadzenScheduler>

@code
{
    private List<WorkTimeDto> _workTimes = new();

    protected override async Task OnInitializedAsync()
    {

        await LoadWorkTimes();
    }

    private async Task OnAdd(SchedulerSlotSelectEventArgs args)
    {
        await dialog.OpenAsync("Add Work Time", ds =>
        @<WorkTimeForm OnReloadList="@LoadWorkTimes"
                        IsInsert="true"
                        StartDate="@args.Start">
        </WorkTimeForm>,
        null);
    }

    private async Task LoadWorkTimes()
    {
        try
        {
            fetch.IsBusy = true;

            WorkTimeFilterDto filter = new WorkTimeFilterDto();

            var result = await execute.WorkTime_FindAssociatedWorkTimesByEmployeeId(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                _workTimes = JsonSerializer.Deserialize<List<WorkTimeDto>>(result.data.ToString());
            }
            fetch.IsBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}