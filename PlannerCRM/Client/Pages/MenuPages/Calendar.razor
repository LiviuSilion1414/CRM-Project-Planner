@page "/calendar"

<h4>Calendar</h4>
<PageTitle>Calendar</PageTitle>

@if (fetch.isBusy)
{
    <Loader />
}
else
{
    <RadzenScheduler TItem="ActivityDto"
                     Style="height: 80vh;"
                     Data=@_activities
                     Culture="CultureInfo.InvariantCulture"
                     SlotSelect="@OnAdd"
                     AppointmentSelect="@OnSelect"
                     StartProperty="@nameof(ActivityDto.startDate)"
                     EndProperty="@nameof(ActivityDto.endDate)"
                     TextProperty="@nameof(ActivityDto.name)"
                     AppointmentRender="@OnEventRender"
                     SelectedIndex="1">
        <RadzenWeekView />
        <RadzenMonthView />
    </RadzenScheduler>
}
@code {
    private List<ActivityDto> _activities = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var result = await fetch.Activity_List(new ActivityFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                _activities = JsonSerializer.Deserialize<List<ActivityDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task OnSelect(SchedulerAppointmentSelectEventArgs<ActivityDto> args)
    {

        await dialog.OpenAsync("Activity Info", ds =>
        @<ActivityDialog SelectedActivity="@args.Data"
                         OnReloadList="() => LoadData()" />,
        new DialogOptions() { Width = "90vw;" }
    );
    }

    private async Task OnAdd(SchedulerSlotSelectEventArgs args)
    {
        await dialog.OpenAsync("Add activity",
            ds => @<ActivityForm OnReloadList="() => LoadData()" IsInsert="true" />,
            new DialogOptions() { Width = "40vw;" }
        );
    }

    void OnEventRender(SchedulerAppointmentRenderEventArgs<ActivityDto> args)
    {
        args.Attributes["style"] = $"background-color: {args.Data.hexColor};";
    }
}