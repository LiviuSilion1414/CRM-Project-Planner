@page "/systemlog-list"
@using static PlannerCRM.Shared.Dtos.DtoShared

<PageContainer PageTitle="System Log" 
               Description="A centralized logging system that captures application errors and critical events in real time. 
                            It provides a single, unified page where errors can be reviewed, analyzed, and managed, enabling faster troubleshooting, 
                            consistent handling, and improved system reliability.">
    <ChildContent>
        <RadzenCard class="mb-3">
            <RadzenRow JustifyContent="JustifyContent.Stretch">
                <RadzenColumn>
                    <RadzenFormField Text="Username" AllowFloatingLabel="false">
                        <RadzenTextBox class="form-control" Style="min-width: 30vw;" @bind-Value="@username" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenFormField Text="Date" AllowFloatingLabel="false">
                        <RadzenDatePicker class="form-control" DateFormat="dd/MM/yyyy" @bind-Value="@date" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <DynamicGrid ApiController="@ApiUrl.SYSTEMLOG_CONTROLLER"
                     AllowInsert="true"
                     AllowUpdate="true"
                     AllowDelete="true"
                     TItem="@SystemLogDto"
                     ItemsList="@systemLogList"
                     ModelTitle="System Log"
                     OnReloadList="LoadData"
                     OnReset="ResetData" />
    </ChildContent>
</PageContainer>

@code
{
    List<SystemLogDto> systemLogList = new();

    string? username;
    DateTime? date;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task ResetData()
    {
        username = null;
        date = null;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new SystemLogFilterDto
            {
                username = username,
                date = date
            };

            var result = await fetch.SystemLog_List(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                systemLogList = JsonSerializer.Deserialize<List<SystemLogDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}
