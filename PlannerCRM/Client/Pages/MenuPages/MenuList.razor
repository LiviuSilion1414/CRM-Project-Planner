@page "/menu-list"
@using static PlannerCRM.Shared.Dtos.DtoShared

<h3>Menu List</h3>
<PageTitle>Menu List</PageTitle>

<RadzenCard class="mb-3">
    <RadzenRow JustifyContent="JustifyContent.Stretch">
        <RadzenColumn>
            <RadzenFormField Text="Name" AllowFloatingLabel="false">
                <RadzenTextBox class="form-control" Style="min-width: 30vw;" @bind-Value="@query" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>

<DynamicGrid ApiController="@ApiUrl.MENU_CONTROLLER"
             AllowInsert="true"
             AllowUpdate="true"
             AllowDelete="true"
             TItem="@MenuDto"
             ItemsList="@menuList"
             ModelTitle="Menu"
             OnAdvancedUpdate="AdvancedUpdate"
             OnReloadList="LoadData"
             OnReset="ResetData"/>

@code
{
    List<MenuDto> menuList = new();

    string query = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task ResetData()
    {
        query = string.Empty;
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            var filter = new MenuFilterDto
            {
                title = query
            };

            var result = await fetch.Menu_List(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                menuList = JsonSerializer.Deserialize<List<MenuDto>>(result.data.ToString()).OrderByDescending(x => x.ranking).ToList();
            }
            fetch.isBusy = false;
        } catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
    
    async Task AdvancedUpdate(MenuDto item)
    {
        await dialog.OpenAsync($"Advanced editing", ds =>
        @<MenuForm menuDto="@item" OnReloadList="LoadData" />,
        new DialogOptions
        {
            Width = "80%",
            Height = "90%",
            CloseDialogOnEsc = true,
            ShowClose = true
        });
    }
    
    async Task ReloadMenuRoles()
    {
        navigation.Refresh(forceReload: true);
    }
}
