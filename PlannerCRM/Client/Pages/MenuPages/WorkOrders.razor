@page "/workOrders"
@using static PlannerCRM.Shared.Dtos.DtoShared

<h3>Work Orders</h3>
<PageTitle>Work Orders</PageTitle>

@if (fetch.isBusy)
{
    <Loader />
}
else
{
    <RadzenCard class="mb-3">
        <RadzenRow JustifyContent="JustifyContent.Stretch">
            <RadzenColumn>
                <RadzenFormField Text="Title" AllowFloatingLabel="false">
                    <RadzenTextBox class="form-control" Style="min-width: 30vw;" @bind-Value="@title" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <DynamicGrid ApiController="@ApiUrl.WORKORDER_CONTROLLER"
                    TItem="@WorkOrderDto" 
                    AllowInsert="true"
                    AllowUpdate="true"
                    AllowDelete="true"
                    ItemsList="@_workOrders"
                    ModelTitle="Work Order"
                    OnReloadList="LoadData"
                    OnReset="@ResetData" />

}

@code
{
    private List<WorkOrderDto> _workOrders = new();

    private string? title;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            fetch.isBusy = true;

            WorkOrderFilterDto filter = new WorkOrderFilterDto()
            {
                searchQuery = title
            };

            var result = await fetch.WorkOrder_List(new WorkOrderFilterDto());

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                _workOrders = JsonSerializer.Deserialize<List<WorkOrderDto>>(result.data.ToString());
            }
            fetch.isBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    private async Task ResetData()
    {
        title = null;

        await LoadData();
    }

}