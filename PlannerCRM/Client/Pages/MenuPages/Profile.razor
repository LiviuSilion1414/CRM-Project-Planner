@page "/profile"

@layout MainLayout

@attribute [Authorize]

@if (currentUser == null || _context == null)
{
    <p>Loading data..</p>
}
else
{
    <RadzenStack JustifyContent="JustifyContent.Center">
        <EditForm EditContext="@_context" OnValidSubmit="Submit">
            <RadzenCard>
                <RadzenFieldset Text="Informations">
                    <DataAnnotationsValidator />
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenLabel>Name</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn>
                            <InputText class="form-control" @bind-Value="@currentUser.name" />
                            <ValidationMessage For="@(() => currentUser.name)" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenLabel>Surname</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn>
                            <InputText class="form-control" @bind-Value="@currentUser.surname" />
                            <ValidationMessage For="@(() => currentUser.surname)" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenLabel>Email</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn>
                            <InputText class="form-control" @bind-Value="@currentUser.username" />
                            <ValidationMessage For="@(() => currentUser.username)" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow>
                        <RadzenColumn>
                            <RadzenButton Icon="question_mark" ButtonStyle="ButtonStyle.Info" Variant="Variant.Flat" Size="ButtonSize.ExtraSmall" Click="@ShowAlert" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenLabel>Password</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn>
                            <InputText class="form-control" @bind-Value="@currentUser.newPassword" />
                            <ValidationMessage For="@(() => currentUser.newPassword)" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>
                <RadzenFieldset Text="Roles">
                    <RadzenRow class="mt-3">
                        <RadzenColumn>
                            <RadzenDataGrid @ref="grid"
                            TItem="EmployeesRoleDto"
                            Data="@currentUser.employeesRoles"
                            PageSize="5"
                            AllowPaging="true"
                            AllowSorting="true">
                                <Columns>
                                    <RadzenDataGridColumn TItem="EmployeesRoleDto" Property="@nameof(EmployeesRoleDto.roleName)" Title="Role Name" />
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>
                <RadzenStack AlignItems="AlignItems.Center" class="mt-3">
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenButton ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Text="Cancel" Click="Close"></RadzenButton>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenButton ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Text="Save" ButtonType="ButtonType.Submit"></RadzenButton>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>
        </EditForm>
    </RadzenStack>
}

@code
{
    [Parameter] public EventCallback OnReloadList { get; set; }
    [Parameter] public EventCallback OnCloseSide { get; set; }

    EmployeeDto currentUser = new();
    RoleDto assignedRole = new();

    List<RoleDto> roles = new();

    EditContext _context;

    RadzenDataGrid<EmployeesRoleDto> grid;

    protected override async Task OnInitializedAsync()
    {
        currentUser.id = await auth.GetCurrentUserIdAsync();

        await LoadData();
    }

    void Close()
    {
        dialog.Close();
    }

    async Task ShowAlert()
    {
        await dialog.OpenAsync("Modifica password", ds =>
        @<RadzenAlert Title="Password"
                          AlertStyle="AlertStyle.Info"
                          Variant="Variant.Flat"
                          Shade="Shade.Lighter"
                          Size="AlertSize.ExtraSmall"
                          AllowClose="false">
            If you forgot your password you can create a new one here.
            Leaving it unchanged, the old password won't change.
        </RadzenAlert>
    ,
        new DialogOptions
        {
            Width="30%",
            CloseDialogOnEsc = true,
        });
    }

    private async Task LoadData()
    {
        try
        {
            fetch.IsBusy = true;

            var filter = new EmployeeFilterDto() { employeeId = currentUser.id, isEditProfile = true };

            var result = await execute.Employee_Get(filter);

            if (result.data is not null && result.hasCompleted && result.messageType == MessageType.Success)
            {
                currentUser = JsonSerializer.Deserialize<EmployeeDto>(result.data.ToString());
                _context = new EditContext(currentUser);
            }
            fetch.IsBusy = false;
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }

    async Task Submit()
    {
        try
        {
            if (_context.Validate())
            {
                ResultDto result = await execute.Employee_Update(currentUser);

                if (result.hasCompleted && result.statusCode == HttpStatusCode.OK)
                {
                    notification.Notify(NotificationSeverity.Success, result.message, null, 4000);
                    await OnReloadList.InvokeAsync();
                }
                else
                {
                    notification.Notify(NotificationSeverity.Error, result.message, null, 4000);
                }
            }
        }
        catch
        {
            notification.Notify(NotificationSeverity.Warning, "Something went wrong, please retry", null, 4000);
        }
    }
}
